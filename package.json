{
  "name": "bento-browser",
  "version": "0.0.0",
  "private": true,
  "description": "Bento Browser — an independent browser derived from Mozilla Firefox.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "download": "bash scripts/bento-env.sh download",
    "bootstrap": "bash scripts/bento-env.sh bootstrap",
    "import": "bash scripts/import.sh && pnpm run chrome:resize-check",
    "build": "pnpm run ext:build && pnpm run import && bash scripts/bento-env.sh build && bash scripts/sync-builtin-addon-symlinks.sh",
    "build:ui": "bash scripts/bento-env.sh build --ui && bash scripts/sync-builtin-addon-symlinks.sh",
    "package": "bash scripts/bento-env.sh package",
    "artifacts:check": "node scripts/validate-bento-artifacts.mjs",
    "lc": "pnpm run theme:sync && node scripts/generate-chrome-tokens.mjs && pnpm run chrome:resize-check && bash scripts/bento-env.sh license-check",
    "mach": "bash scripts/mach-raw.sh",
    "mach:build": "bash scripts/mach-raw.sh build",
    "build:full": "bash scripts/build-bento.sh",
    "build:release": "bash scripts/build-release.sh",
    "firefox:sync": "bash scripts/sync-firefox-upstream.sh",
    "firefox:patches:check": "node scripts/firefox-patch-stack.mjs check",
    "firefox:patches:apply": "node scripts/firefox-patch-stack.mjs apply",
    "firefox:patches:materialize": "node scripts/firefox-patch-stack.mjs materialize",
    "firefox:patches:rebase": "node scripts/firefox-patch-stack.mjs rebase",
    "firefox:patches:export": "node scripts/firefox-patch-stack.mjs export",
    "firefox:patches:test": "node --test scripts/firefox-patch-stack.test.mjs",
    "firefox:compat:check": "node scripts/check-firefox-compat.mjs",
    "firefox:compat:engine": "node scripts/check-firefox-compat.mjs --engine engine",
    "firefox:compat:test": "node --test scripts/check-firefox-compat.test.mjs",
    "chrome:resize-check": "node scripts/check-chrome-resize-guard.mjs",
    "import:branding": "node scripts/install-branding.mjs",
    "import:addons": "node scripts/install-builtin-addons.mjs",
    "lint:repo": "eslint scripts src/browser .agents",
    "lint:aliases": "node scripts/check-legacy-aliases.mjs",
    "lint:tokens": "node scripts/check-undefined-tokens.mjs",
    "lint:motion": "node scripts/check-motion-values.mjs",
    "check:zen-boundary": "node scripts/check-zen-boundary.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "test:boundary-detector": "node --test scripts/boundary-detector.test.mjs",
    "test:size-ratchet": "node --test scripts/size-ratchet.test.mjs",
    "test:agent-skills": "node --test .agents/skills/bento-upgrade-firefox/scripts/*.test.mjs",
    "check:product-identity": "node scripts/check-product-identity.mjs branding/bento",
    "security:check": "node scripts/check-security-invariants.mjs",
    "release:security-check": "node scripts/check-release-security.mjs --channel=preview",
    "release:security-check:shell": "node scripts/check-release-security.mjs --built-shell",
    "release:security-check:public": "node scripts/check-release-security.mjs --channel=public",
    "release:sbom": "node scripts/generate-release-sbom.mjs",
    "release:metadata": "node scripts/generate-release-metadata.mjs",
    "brand:regen": "bash scripts/regen-branding.sh",
    "dev": "pnpm run ext:build && pnpm run import && bash scripts/dev-profile-clean.sh && bash scripts/dev-launch.sh",
    "dev:fresh": "pnpm run ext:build && pnpm run import && bash scripts/dev-launch.sh $(mktemp -d)",
    "dev:mux": "pnpm run theme:sync && pnpm run tools:build && pnpm run shell:import:mux && bash scripts/dev-profile-clean.sh && bash scripts/dev-launch.sh",
    "dev:fresh:mux": "pnpm run theme:sync && pnpm run tools:build && pnpm run shell:import:mux && bash scripts/dev-launch.sh $(mktemp -d)",
    "shell:dev": "pnpm --filter @bento/shell dev",
    "shell:build": "pnpm --filter @bento/shell build",
    "shell:sync": "pnpm run shell:build && bash scripts/sync-shell.sh",
    "shell:ladle": "pnpm --filter @bento/shell ladle:serve",
    "shell:ladle:mux": "node scripts/muxui-dev.mjs ladle",
    "shell:dev:mux": "node scripts/muxui-dev.mjs dev",
    "shell:import:mux": "node scripts/muxui-dev.mjs import",
    "tools:build": "pnpm --filter @bento/tools build",
    "ext:build": "pnpm run theme:sync && pnpm --filter @bento/shell build && pnpm --filter @bento/tools build",
    "size": "BENTO_RELEASE=1 pnpm run ext:build && pnpm run size:check",
    "size:check": "node scripts/check-size-budgets.mjs",
    "size:baseline": "BENTO_RELEASE=1 pnpm run ext:build && node scripts/check-size-budgets.mjs --write-baseline",
    "theme:import": "node scripts/import-theme.mjs && node scripts/sync-theme-presets.mjs",
    "theme:sync": "node scripts/sync-theme-presets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "globals": "^14.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "tiny-glob": "^0.2.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "6.4.4",
    "vitest": "^4.1.7",
    "yaml": "2.8.4"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "brace-expansion@1.1.14": "1.1.21",
      "brace-expansion@5.0.5": "5.0.12",
      "browserslist": "4.28.7",
      "js-yaml": "4.3.2",
      "nanoid": "3.3.18",
      "postcss": "8.5.29",
      "query-string>decode-uri-component": "0.5.1",
      "source-map-js": "1.2.2",
      "vite": "6.4.4",
      "@react-types/shared": "3.36.1",
      "react-aria": "3.51.0",
      "react-aria-components": "1.20.0",
      "react-stately": "3.49.0",
      "@tiptap/core": "3.31.4",
      "@tiptap/extension-image": "3.31.4",
      "@tiptap/extension-placeholder": "3.31.4",
      "@tiptap/extension-text-align": "3.31.4",
      "@tiptap/extension-text-style": "3.31.4",
      "@tiptap/extensions": "3.31.4",
      "@tiptap/pm": "3.31.4",
      "@tiptap/react": "3.31.4",
      "@tiptap/starter-kit": "3.31.4"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "license": "MPL-2.0"
}
