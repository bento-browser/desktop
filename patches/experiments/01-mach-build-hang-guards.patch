From bb3a31a345565338af8dd9bda08c2b32025b5156 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Wed, 24 Jun 2026 19:23:42 +1000
Subject: [PATCH] Add mach build hang guards

---
 build/mach_initialize.py                             |  2 +-
 python/mach/mach/main.py                             | 12 ++++++++----
 python/mach/mach/mixin/process.py                    |  2 +-
 python/mozbuild/mozbuild/base.py                     |  2 +-
 .../mozbase/mozprocess/mozprocess/processhandler.py  | 11 +++++++++--
 5 files changed, 20 insertions(+), 9 deletions(-)

diff --git a/build/mach_initialize.py b/build/mach_initialize.py
index fb0170ba89e4994ec41e35eeed9b01da0caf09a8..cbc4322f993d9028ddc38055dc14c32bfd31f795 100644
--- a/build/mach_initialize.py
+++ b/build/mach_initialize.py
@@ -298,7 +298,7 @@ def initialize(topsrcdir, args=()):
 
         # Wait for the background telemetry initialization to complete
         if context._telemetry_init_done is not None:
-            context._telemetry_init_done.wait()
+            context._telemetry_init_done.wait(timeout=30)
 
         _finalize_telemetry_glean(
             context.telemetry,
diff --git a/python/mach/mach/main.py b/python/mach/mach/main.py
index c1abf1ad7455d6df0dd62f76f617bb4570e5cdcf..c36bec8df4326636612111eae0d05f8d2c875b0b 100644
--- a/python/mach/mach/main.py
+++ b/python/mach/mach/main.py
@@ -388,9 +388,13 @@ To see more help for a specific command, run:
             def _finish_telemetry_init(future):
                 from .telemetry import report_invocation_metrics
 
-                context.telemetry = future.result()
-                report_invocation_metrics(context.telemetry, handler.name)
-                context._telemetry_init_done.set()
+                try:
+                    context.telemetry = future.result()
+                    report_invocation_metrics(context.telemetry, handler.name)
+                except Exception:
+                    self.logger.exception("Failed to initialize mach telemetry.")
+                finally:
+                    context._telemetry_init_done.set()
 
             self._telemetry_future.add_done_callback(_finish_telemetry_init)
 
@@ -504,7 +508,7 @@ To see more help for a specific command, run:
             return 1
         finally:
             if context._telemetry_init_done is not None:
-                context._telemetry_init_done.wait()
+                context._telemetry_init_done.wait(timeout=30)
 
     def log(self, level, action, params, format_str):
         """Helper method to record a structured log event."""
diff --git a/python/mach/mach/mixin/process.py b/python/mach/mach/mixin/process.py
index 1105b25c04e5db54519323208b7f3230be0ef8b6..2206c6227bc9f93ccab09a8a90c501ae705f7320 100644
--- a/python/mach/mach/mixin/process.py
+++ b/python/mach/mach/mixin/process.py
@@ -162,7 +162,7 @@ class ProcessExecutionMixin(LoggingMixin):
         self.log(logging.DEBUG, "process", {"env": str(use_env)}, "Environment: {env}")
 
         if pass_thru:
-            proc = subprocess.Popen(args, cwd=cwd, env=use_env, close_fds=False)
+            proc = subprocess.Popen(args, cwd=cwd, env=use_env, close_fds=True)
             status = None
             # Leave it to the subprocess to handle Ctrl+C. If it terminates as
             # a result of Ctrl+C, proc.wait() will return a status code, and,
diff --git a/python/mozbuild/mozbuild/base.py b/python/mozbuild/mozbuild/base.py
index 7325c8b4b8474571e616c21347163a6d41a367c8..5fb33cc49463763d477acac4a13c97085e579a2e 100644
--- a/python/mozbuild/mozbuild/base.py
+++ b/python/mozbuild/mozbuild/base.py
@@ -1096,7 +1096,7 @@ class MachCommandBase(MozbuildObject):
     def metrics(self):
         if self._metrics is None and self._metrics_path:
             if self._mach_context._telemetry_init_done is not None:
-                self._mach_context._telemetry_init_done.wait()
+                self._mach_context._telemetry_init_done.wait(timeout=30)
             self._metrics = self._mach_context.telemetry.metrics(self._metrics_path)
         return self._metrics
 
diff --git a/testing/mozbase/mozprocess/mozprocess/processhandler.py b/testing/mozbase/mozprocess/mozprocess/processhandler.py
index fc68d4e6694d7e755c58b30c8b4c096ce9c41498..55af6afb80e5d59fabd8e1911930dbfd28bb4bee 100644
--- a/testing/mozbase/mozprocess/mozprocess/processhandler.py
+++ b/testing/mozbase/mozprocess/mozprocess/processhandler.py
@@ -98,7 +98,7 @@ class ProcessHandlerMixin:
             stdout=None,
             stderr=None,
             preexec_fn=None,
-            close_fds=False,
+            close_fds=True,
             shell=False,
             cwd=None,
             env=None,
@@ -891,6 +891,7 @@ falling back to not using job objects for managing child processes""",
             env=self.env,
             ignore_children=self._ignore_children,
         )
+        args.setdefault("close_fds", True)
 
         # build process arguments
         args.update(self.keywordargs)
@@ -1006,7 +1007,13 @@ falling back to not using job objects for managing child processes""",
                 while self.reader.is_still_reading(timeout=0.1):
                     time.sleep(0.1)
             else:
-                self.reader.join()
+                self.reader.join(timeout=30)
+                if self.reader.is_alive():
+                    print(
+                        "WARNING | Process output reader did not finish; "
+                        "continuing after process exit.",
+                        file=sys.stderr,
+                    )
         return self.returncode
 
     @property
-- 
