From c0035bebd4fbdfe93adb8ea9366b6ce4dd8f0038 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Mon, 2 Nov 2026 03:07:44 +1100
Subject: [PATCH] Wire MOZ_APPUPDATE_HOST through configure

---
 build/moz.configure/update-programs.configure | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/build/moz.configure/update-programs.configure b/build/moz.configure/update-programs.configure
index 6351d36cf29c1b22b9c9306953513fdbc43c63fb..645b6abca9261efce72932d3ab793657aaadd7ea 100644
--- a/build/moz.configure/update-programs.configure
+++ b/build/moz.configure/update-programs.configure
@@ -159,6 +159,19 @@ set_config(
     depends_if("ACCEPTED_MAR_CHANNEL_IDS")(lambda channels: ",".join(channels)),
 )
 
+# Application update host
+# ==============================================================
+
+# Bento sets this from bento.json updates.hostname. build/moz.build substitutes
+# it into the [AppUpdate] URL that build/application.ini.in compiles into the
+# application data, in place of the aus5.mozilla.org default.
+option(env="MOZ_APPUPDATE_HOST", nargs=1, help="Application update hostname")
+
+set_config(
+    "MOZ_APPUPDATE_HOST",
+    depends_if("MOZ_APPUPDATE_HOST")(lambda host: host[0]),
+)
+
 # Use NSS for MAR signatures even on platforms where system libraries are
 # supported (currently Windows and macOS).
 # ==============================================================
-- 
