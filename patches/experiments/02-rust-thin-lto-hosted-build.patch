From 52389beee859ebd6b9831069884e731a4740e629 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Mon, 24 Aug 2026 14:13:08 +1000
Subject: [PATCH] Use ThinLTO for hosted release Rust linking

---
 browser/moz.configure                     | 11 +++++++++++
 python/mozbuild/mozbuild/rust_commands.py |  6 +++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/browser/moz.configure b/browser/moz.configure
index 8979a2e4e8d92e9aa4478c397cf4891211608f24..9bc43f7db4bf272b2d33a879a86f3980859f801b 100644
--- a/browser/moz.configure
+++ b/browser/moz.configure
@@ -17,6 +17,17 @@ imply_option("MOZ_APP_ID", "{ec8030f7-c20a-464f-9b0e-13a3a9e97384}")
 imply_option("MOZ_DEVTOOLS", "all")
 imply_option("BROWSER_CHROME_URL", "chrome://browser/content/browser.xhtml")
 
+# Keep the hosted-build ThinLTO opt-in namespaced and explicit.  It is
+# consumed by python/mozbuild/mozbuild/rust_commands.py through the
+# serialized Cargo configuration.
+option(
+    env="BENTO_RUST_LTO",
+    nargs=1,
+    choices=("thin",),
+    help="Use Bento's hosted Rust ThinLTO mode",
+)
+set_config("BENTO_RUST_LTO", depends_if("BENTO_RUST_LTO")(lambda v: v[0]))
+
 
 with only_when(target_has_linux_kernel & compile_environment):
     option(env="MOZ_NO_PIE_COMPAT", help="Enable non-PIE wrapper")
diff --git a/python/mozbuild/mozbuild/rust_commands.py b/python/mozbuild/mozbuild/rust_commands.py
index 445185b521237d17213cb5377b71b1f8287fa463..a91506bf777d35d3f330c3669e207ff19e8935d8 100644
--- a/python/mozbuild/mozbuild/rust_commands.py
+++ b/python/mozbuild/mozbuild/rust_commands.py
@@ -50,6 +50,7 @@ def _bool(v):
 # holds once, and it rejects a read of anything absent from here.
 CARGO_CONFIG_KEYS = {
     "AR": _as_str,
+    "BENTO_RUST_LTO": _as_str,
     "BINDGEN_EXTRA_CLANG_ARGS": _as_list,
     "CARGO": _as_str,
     "CARGOFLAGS": _as_args,
@@ -434,7 +435,10 @@ def _rustc_flags(cmd, substs, invocation):
         flags += substs.get("MOZ_RUST_LIBRARY_RUSTCFLAGS")
 
     if applies_library_lto(cmd.kind, cmd.lto, substs):
-        flags.append("-Clto")
+        # Keep Firefox's default fat LTO unless a Bento hosted builder opts in.
+        flags.append(
+            "-Clto=thin" if substs.get("BENTO_RUST_LTO") == "thin" else "-Clto"
+        )
 
     flags += invocation.cargo_rustcflags
 
-- 
