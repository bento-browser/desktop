From 0f8771355ba747ff459004ff3c6524b329f4db09 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Mon, 24 Aug 2026 14:13:08 +1000
Subject: [PATCH] Use ThinLTO for hosted release Rust linking

---
 browser/moz.configure    | 11 +++++++++++
 config/makefiles/rust.mk |  4 +++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/browser/moz.configure b/browser/moz.configure
index ef7de8397fa9e2dbdf5256e025a947eadbef779d..24c5ae544d5384311dbc52773733beea8d14b389 100644
--- a/browser/moz.configure
+++ b/browser/moz.configure
@@ -17,6 +17,17 @@ imply_option("MOZ_APP_ID", "{ec8030f7-c20a-464f-9b0e-13a3a9e97384}")
 imply_option("MOZ_DEVTOOLS", "all")
 imply_option("BROWSER_CHROME_URL", "chrome://browser/content/browser.xhtml")
 
+# Keep the hosted-build ThinLTO opt-in namespaced and explicit.  It is
+# consumed by config/makefiles/rust.mk after configure writes the value to
+# the generated make configuration.
+option(
+    env="BENTO_RUST_LTO",
+    nargs=1,
+    choices=("thin",),
+    help="Use Bento's hosted Rust ThinLTO mode",
+)
+set_config("BENTO_RUST_LTO", depends_if("BENTO_RUST_LTO")(lambda v: v[0]))
+
 
 with only_when(target_has_linux_kernel & compile_environment):
     option(env="MOZ_NO_PIE_COMPAT", help="Enable non-PIE wrapper")
diff --git a/config/makefiles/rust.mk b/config/makefiles/rust.mk
index ab3304484180de276f863c15dfdd7d13d27fb135..01350d30f730abbdb1200599531654c32482598f 100644
--- a/config/makefiles/rust.mk
+++ b/config/makefiles/rust.mk
@@ -56,7 +56,9 @@ cargo_build_flags += $(MOZ_CARGO_BUILD_STD_ARGS)
 cargo_rustc_flags = $(CARGO_RUSTCFLAGS)
 # Enable link-time optimization for release builds.
 ifdef RUST_LIBRARY_LTO
-cargo_rustc_flags += -Clto
+# Keep Firefox's default fat LTO unless a Bento hosted builder opts into
+# standard Rust ThinLTO to reduce peak linker memory.
+cargo_rustc_flags += $(if $(filter thin,$(BENTO_RUST_LTO)),-Clto=thin,-Clto)
 endif
 
 ifdef CARGO_INCREMENTAL
-- 
