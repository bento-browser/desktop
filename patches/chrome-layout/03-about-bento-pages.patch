diff --git a/browser/components/aboutbento/AboutBentoModule.sys.mjs b/browser/components/aboutbento/AboutBentoModule.sys.mjs
new file mode 100644
index 0000000..3c6e764
--- /dev/null
+++ b/browser/components/aboutbento/AboutBentoModule.sys.mjs
@@ -0,0 +1,49 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const EXTENSION_ID = "bento-shell@bento.app";
+
+const PAGES = {
+  "bento-settings": "dist/settings.html",
+  "bento-privacy": "dist/privacy.html",
+};
+
+class AboutBentoPage {
+  constructor(host) {
+    this.host = host;
+  }
+
+  getURIFlags() {
+    return (
+      Ci.nsIAboutModule.URI_SAFE_FOR_UNTRUSTED_CONTENT |
+      Ci.nsIAboutModule.ALLOW_SCRIPT |
+      Ci.nsIAboutModule.URI_MUST_LOAD_IN_CHILD
+    );
+  }
+
+  newChannel(uri, loadInfo) {
+    const policy = WebExtensionPolicy.getByID(EXTENSION_ID);
+    if (!policy) {
+      throw Components.Exception(
+        "bento-shell extension not loaded",
+        Cr.NS_ERROR_NOT_AVAILABLE
+      );
+    }
+    const target = Services.io.newURI(policy.getURL(PAGES[this.host]));
+    const channel = Services.io.newChannelFromURIWithLoadInfo(target, loadInfo);
+    channel.originalURI = uri;
+    return channel;
+  }
+}
+AboutBentoPage.prototype.QueryInterface = ChromeUtils.generateQI([
+  "nsIAboutModule",
+]);
+
+export function AboutBentoSettings() {
+  return new AboutBentoPage("bento-settings");
+}
+
+export function AboutBentoPrivacy() {
+  return new AboutBentoPage("bento-privacy");
+}
