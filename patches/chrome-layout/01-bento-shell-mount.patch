 # file, You can obtain one at http://mozilla.org/MPL/2.0/.

-<hbox flex="1" id="browser">
+<hbox flex="1" id="browser" style="position: relative;">
+  <vbox id="bento-shell-host"
+        persist="width"
+        width="240"
+        style="min-width: 200px; max-width: 600px;">
+    <browser id="bento-shell-frame"
+             type="content"
+             remote="true"
+             remoteType="extension"
+             primary="false"
+             flex="1"
+             disablehistory="true"
+             disablefullscreen="true"
+             transparent="transparent"/>
+  </vbox>
+  <splitter id="bento-shell-splitter"
+            class="chromeclass-extrachrome"
+            resizebefore="sibling"
+            resizeafter="none"
+            style="cursor: col-resize; background-color: transparent;"/>
+  <vbox id="bento-palette-host" hidden="true"
+        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 99999; background-color: transparent; pointer-events: auto; display: none; opacity: 0; transition: opacity 0.18s ease;">
+    <browser id="bento-palette-frame"
+             type="content" remote="true" remoteType="extension"
+             primary="false" flex="1"
+             transparent="transparent"
+             style="background-color: transparent; -moz-appearance: none;"/>
+  </vbox>
+  <vbox id="bento-confirm-host" hidden="true"
+        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 99998; background-color: transparent; pointer-events: auto; display: none; opacity: 0; transition: opacity 0.18s ease;">
+    <browser id="bento-confirm-frame"
+             type="content" remote="true" remoteType="extension"
+             primary="false" flex="1"
+             transparent="transparent"
+             style="background-color: transparent; -moz-appearance: none;"/>
+  </vbox>
+  <vbox id="bento-menu-host" hidden="true"
+        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 100000; background-color: transparent; pointer-events: auto; display: none;">
+    <browser id="bento-menu-frame"
+             type="content" remote="true" remoteType="extension"
+             primary="false" flex="1"
+             transparent="transparent"
+             style="background-color: transparent; -moz-appearance: none;"/>
+  </vbox>
+  <script src="chrome://browser/content/bento-shell-mount.js"></script>
   <box context="sidebar-context-menu" id="sidebar-main" hidden="true">
     <html:sidebar-main flex="1">
       <box id="vertical-tabs" slot="tabstrip" customizable="true" contextmenu="toolbar-context-menu"></box>
