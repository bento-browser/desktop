From 43b6dc7de2e8b38424a8d247eab036412a41e678 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Wed, 24 Jun 2026 19:23:25 +1000
Subject: [PATCH] Add Bento shell mount to browser chrome

---
 browser/base/content/browser-box.inc.xhtml | 54 +++++++++++++++++++++-
 browser/base/jar.mn                        |  9 ++++
 2 files changed, 62 insertions(+), 1 deletion(-)

diff --git a/browser/base/content/browser-box.inc.xhtml b/browser/base/content/browser-box.inc.xhtml
index 599313b65c654906f3d52c0852d284937e31d09c..840418d0e34171c2cf45f9dd18230bb45cb5540a 100644
--- a/browser/base/content/browser-box.inc.xhtml
+++ b/browser/base/content/browser-box.inc.xhtml
@@ -2,7 +2,59 @@
 # License, v. 2.0. If a copy of the MPL was not distributed with this
 # file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
-<hbox flex="1" id="browser">
+<hbox flex="1" id="browser" style="position: relative;">
+  <vbox id="bento-shell-host"
+        persist="width"
+        width="300"
+        style="width: 300px; min-width: 200px; max-width: 600px;">
+    <browser id="bento-shell-frame"
+             type="content"
+             remote="true"
+             remoteType="extension"
+             primary="false"
+             flex="1"
+             disablehistory="true"
+             disablefullscreen="true"
+             transparent="transparent"/>
+  </vbox>
+  <splitter id="bento-shell-splitter"
+            class="chromeclass-extrachrome"
+            resizebefore="sibling"
+            resizeafter="none"
+            style="cursor: col-resize; background-color: transparent;"/>
+  <vbox id="bento-palette-host" hidden="true"
+        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 99999; background-color: transparent; pointer-events: auto; display: none; opacity: 0; transition: opacity 0.18s ease;">
+    <browser id="bento-palette-frame"
+             type="content" remote="true" remoteType="extension"
+             primary="false" flex="1"
+             transparent="transparent"
+             style="background-color: transparent; -moz-appearance: none;"/>
+  </vbox>
+  <vbox id="bento-merge-palette-host" hidden="true"
+        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 99997; background-color: transparent; pointer-events: auto; display: none; opacity: 0; transition: opacity 0.18s ease;">
+    <browser id="bento-merge-palette-frame"
+             type="content" remote="true" remoteType="extension"
+             primary="false" flex="1"
+             transparent="transparent"
+             style="background-color: transparent; -moz-appearance: none;"/>
+  </vbox>
+  <vbox id="bento-confirm-host" hidden="true"
+        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 99998; background-color: transparent; pointer-events: auto; display: none; opacity: 0; transition: opacity 0.18s ease;">
+    <browser id="bento-confirm-frame"
+             type="content" remote="true" remoteType="extension"
+             primary="false" flex="1"
+             transparent="transparent"
+             style="background-color: transparent; -moz-appearance: none;"/>
+  </vbox>
+  <vbox id="bento-menu-host" hidden="true"
+        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 100000; background-color: transparent; pointer-events: auto; display: none;">
+    <browser id="bento-menu-frame"
+             type="content" remote="true" remoteType="extension"
+             primary="false" flex="1"
+             transparent="transparent"
+             style="background-color: transparent; -moz-appearance: none;"/>
+  </vbox>
+  <script src="chrome://browser/content/bento-shell-mount.js"></script>
   <box context="sidebar-context-menu" id="sidebar-container" hidden="true">
     <html:sidebar-main flex="1">
       <box id="vertical-tabs" slot="tabstrip" customizable="true" contextmenu="toolbar-context-menu"></box>
diff --git a/browser/base/jar.mn b/browser/base/jar.mn
index b2b5db6040bfa4b0a6923b49669238191fcee1c4..3fe35d8a0dcddcaf469caed0e0c86aa64204ee4b 100644
--- a/browser/base/jar.mn
+++ b/browser/base/jar.mn
@@ -47,6 +47,15 @@ browser.jar:
         content/browser/browser-fullScreenAndPointerLock.js (content/browser-fullScreenAndPointerLock.js)
         content/browser/browser-gestureSupport.js           (content/browser-gestureSupport.js)
         content/browser/browser-init.js                     (content/browser-init.js)
+        content/browser/bento-shell-mount.js                (content/bento-shell-mount.js)
+        content/browser/bento-shell-mount.css               (content/bento-shell-mount.css)
+        content/browser/bento-chrome-tokens.css             (content/bento-chrome-tokens.css)
+        content/browser/bento-chrome-theme.css              (content/bento-chrome-theme.css)
+        content/browser/bento-chrome-themes/                (content/bento-chrome-themes/*.css)
+        content/browser/bento-migration-host.css            (content/bento-migration-host.css)
+        content/browser/bento-migration-host.html           (content/bento-migration-host.html)
+        content/browser/bento-migration-host.js             (content/bento-migration-host.js)
+        content/browser/bento-migration-wizard-bridge.css   (content/bento-migration-wizard-bridge.css)
         content/browser/browser-main.js                     (content/browser-main.js)
         content/browser/browser-menubar.js                  (content/browser-menubar.js)
         content/browser/browser-pageActions.js              (content/browser-pageActions.js)
-- 
2.54.0 (Apple Git-157)

