From 21dce53a784bda9ceafd4790f22a0d27bc4ad5d2 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Wed, 24 Jun 2026 19:23:46 +1000
Subject: [PATCH] Preserve Bento behavior when closing the last tab

---
 .../components/tabbrowser/Tabbrowser.sys.mjs  | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/browser/components/tabbrowser/Tabbrowser.sys.mjs b/browser/components/tabbrowser/Tabbrowser.sys.mjs
index b98a91f6f69f2fdaac02144685d97dbfcc9a5771..53f4899f2b8339e832d004d7d33d91e0520e0d82 100644
--- a/browser/components/tabbrowser/Tabbrowser.sys.mjs
+++ b/browser/components/tabbrowser/Tabbrowser.sys.mjs
@@ -6278,12 +6278,18 @@ export class Tabbrowser {
       metricsContext,
     } = {}
   ) {
-    // When 'closeWindowWithLastTab' pref is enabled, closing all tabs
-    // can be considered equivalent to closing the window.
+    // Bento: the default is hardcoded false (an explicit
+    // closeWindowWithLastTab from the caller is still honored).
+    // bento-tools' tabs.onRemoved handler is the sole authority on
+    // last-tab close behavior. When the last tab in a workspace is
+    // removed, the handler promotes a panel into the main slot, deletes
+    // the workspace and switches to the next, or closes the window.
+    // Letting Firefox short-circuit to closeWindow here pre-empts that
+    // decision. Replaces the default:
+    //   Services.prefs.getBoolPref("browser.tabs.closeWindowWithLastTab")
     if (
       this.tabs.length == tabs.length &&
-      (closeWindowWithLastTab ??
-        Services.prefs.getBoolPref("browser.tabs.closeWindowWithLastTab"))
+      (closeWindowWithLastTab ?? false)
     ) {
       this.documentGlobal.closeWindow(
         true,
@@ -6765,7 +6771,10 @@ export class Tabbrowser {
     var newTab = false;
     if (this.#isLastTabInWindow(aTab)) {
       closeWindow =
-        closeWindowWithLastTab ?? this.#shouldCloseWindowWithLastTab;
+        closeWindowWithLastTab ??
+        // Bento: popup windows (no toolbar) still auto-close on last
+        // tab; toolbar windows defer to bento-tools' handler.
+        !this.documentGlobal.toolbar.visible;
 
       if (closeWindow) {
         // We've already called beforeunload on all the relevant tabs if we get here,
-- 
