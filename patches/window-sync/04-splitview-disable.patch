From b1840a545ea993aa66eed80739bdaf1d93877e77 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Wed, 24 Jun 2026 19:23:47 +1000
Subject: [PATCH] Disable Firefox split view

---
 browser/base/content/nsContextMenu.sys.mjs            |  8 +++++---
 .../components/tabbrowser/content/tab-context-menu.js | 11 ++++++-----
 browser/components/tabbrowser/content/tab.js          |  4 +++-
 3 files changed, 14 insertions(+), 9 deletions(-)

diff --git a/browser/base/content/nsContextMenu.sys.mjs b/browser/base/content/nsContextMenu.sys.mjs
index 778efd5e4f90dd994987f499da61c868770cd181..8b960e37aec18518605a879752034fad78a47ef6 100644
--- a/browser/base/content/nsContextMenu.sys.mjs
+++ b/browser/base/content/nsContextMenu.sys.mjs
@@ -534,9 +534,11 @@ export class nsContextMenu {
     let showContainers =
       Services.prefs.getBoolPref("privacy.userContext.enabled") &&
       lazy.ContextualIdentityService.getPublicIdentities().length;
-    let showSplitViews = Services.prefs.getBoolPref(
-      "browser.tabs.splitView.enabled"
-    );
+    // Bento: hardcoded false — native split-view UI bypasses bento-tools'
+    // PanelStore and produces untracked splits. Bento panels use the
+    // underlying split-view machinery directly; this gate hides the
+    // link context menu's "Open in Split View" entry point.
+    let showSplitViews = false;
     let currentTabInSplitView = !!window.gBrowser?.selectedTab?.splitview;
     let showSmartWindow = lazy.AIWindow.isAIWindowEnabled();
     this.showItem("context-openlink", shouldShow && !isWindowPrivate);
diff --git a/browser/components/tabbrowser/content/tab-context-menu.js b/browser/components/tabbrowser/content/tab-context-menu.js
index be3252ae5f20fdd94e266372a5ccb1eec234fb6d..00bf221f86964b52df5b4dee0fd391d37a219128 100644
--- a/browser/components/tabbrowser/content/tab-context-menu.js
+++ b/browser/components/tabbrowser/content/tab-context-menu.js
@@ -759,11 +759,12 @@ var TabContextMenu = {
       contextEditNote.hidden = true;
     }
 
-    // Split View
-    let splitViewEnabled = Services.prefs.getBoolPref(
-      "browser.tabs.splitView.enabled",
-      false
-    );
+    // Split View — Bento: hardcoded false. The native tab context menu's
+    // split-view entries ("Move Tab to Split View", "Separate Tabs",
+    // "Reverse Tab Order") bypass bento-tools' PanelStore and would
+    // produce untracked splits. Bento panels use the underlying split-
+    // view machinery directly; hiding these items removes the conflict.
+    let splitViewEnabled = false;
     let contextMoveTabToNewSplitView = document.getElementById(
       "context_moveTabToSplitView"
     );
diff --git a/browser/components/tabbrowser/content/tab.js b/browser/components/tabbrowser/content/tab.js
index 9395bcbb798112207861c63ff2707609d9d6c83f..360e72374aaf07fb3f65da7eee5b805c7ce7f7b9 100644
--- a/browser/components/tabbrowser/content/tab.js
+++ b/browser/components/tabbrowser/content/tab.js
@@ -628,7 +628,9 @@
           !event.target.classList.contains("tab-audio-button") &&
           !this.selected &&
           !gBrowser.selectedTab.hidden &&
-          Services.prefs.getBoolPref("browser.tabs.splitView.enabled", false) &&
+          // Bento: alt-click-to-split disabled — bento-tools owns split
+          // creation via PanelStore so the alt-click route stays inert.
+          false &&
           !this.splitview &&
           !gBrowser.selectedTab.splitview &&
           !this.pinned &&
-- 
