From 3558dc7e03cc09e218998abc5c9fb25ced817f55 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Wed, 24 Jun 2026 19:23:38 +1000
Subject: [PATCH] Use transparent scrollbar tracks on macOS

---
 widget/ScrollbarDrawingCocoa.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/widget/ScrollbarDrawingCocoa.cpp b/widget/ScrollbarDrawingCocoa.cpp
index f0dff9276f9880034c800413c4afc2400136b35a..0d7d54bb0a7fe2a4857d7e7a1b548679a471f89a 100644
--- a/widget/ScrollbarDrawingCocoa.cpp
+++ b/widget/ScrollbarDrawingCocoa.cpp
@@ -390,6 +390,10 @@ void ScrollbarDrawingCocoa::DoPaintScrollbar(
     return;
   }
 
+  // Bento: page scrollbars in the main slot and side panels should read
+  // as floating thumbs, without an opaque gutter behind them.
+  return;
+
   // Paint our track.
   const auto color = ComputeScrollbarTrackColor(aFrame, aStyle, aColors);
   ThemeDrawing::FillRect(aPaintData, aRect, color);
-- 
