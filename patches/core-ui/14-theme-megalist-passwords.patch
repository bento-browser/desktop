From 080774e17dfc299407629dbb36d76e21e3350721 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Tue, 7 Jul 2026 16:30:00 +1000
Subject: [PATCH] Theme Passwords megalist with Bento tokens

---
 .../satchel/megalist/content/megalist.css     | 76 +++++++++++++++++++
 .../satchel/megalist/content/megalist.html    |  7 +-
 2 files changed, 82 insertions(+), 1 deletion(-)

diff --git a/toolkit/components/satchel/megalist/content/megalist.css b/toolkit/components/satchel/megalist/content/megalist.css
index 9fd53b13920affbc914336904599880d4566b043..83ef2df0798b502734aed45bcc5de7702c583093 100644
--- a/toolkit/components/satchel/megalist/content/megalist.css
+++ b/toolkit/components/satchel/megalist/content/megalist.css
@@ -4,6 +4,80 @@
 
 /* Bug 1869845 - Styles in this file are still experimental!  */
 
+:root,
+:host {
+  color-scheme: light !important;
+  --background-color-canvas: var(--neutral-default-5, var(--neutral-5)) !important;
+  --background-color-box: var(--neutral-default-10, var(--neutral-10)) !important;
+  --background-color-critical: var(--red-10) !important;
+  --background-color-warning: var(--warning-10) !important;
+  --border-color: var(--neutral-default-20, var(--neutral-20)) !important;
+  --border-color-interactive: var(--neutral-default-18, var(--neutral-18)) !important;
+  --border-color-interactive-hover: var(--neutral-default-24, var(--neutral-24)) !important;
+  --border-color-interactive-active: var(--neutral-default-30, var(--neutral-30)) !important;
+  --border-radius-small: var(--radius-s) !important;
+  --border-radius-medium: var(--radius-m) !important;
+  --border-width: 1px !important;
+  --button-background-color: var(--neutral-default-14, var(--neutral-14)) !important;
+  --button-background-color-hover: var(--neutral-default-16, var(--neutral-16)) !important;
+  --button-background-color-active: var(--neutral-default-22, var(--neutral-22)) !important;
+  --button-background-color-ghost: transparent !important;
+  --button-background-color-ghost-hover: var(--neutral-default-16, var(--neutral-16)) !important;
+  --button-background-color-ghost-active: var(--neutral-default-22, var(--neutral-22)) !important;
+  --button-background-color-primary: var(--color-60) !important;
+  --button-background-color-primary-hover: var(--color-50) !important;
+  --button-background-color-primary-active: var(--color-40) !important;
+  --button-border-color: transparent !important;
+  --button-border-color-ghost-hover: transparent !important;
+  --button-text-color: var(--neutral-default-90, var(--neutral-90)) !important;
+  --button-text-color-hover: var(--neutral-default-90, var(--neutral-90)) !important;
+  --button-text-color-active: var(--neutral-default-90, var(--neutral-90)) !important;
+  --button-text-color-ghost: var(--neutral-default-80, var(--neutral-80)) !important;
+  --button-text-color-ghost-hover: var(--neutral-default-90, var(--neutral-90)) !important;
+  --button-text-color-ghost-active: var(--neutral-default-90, var(--neutral-90)) !important;
+  --button-text-color-primary: var(--color-60-fg) !important;
+  --button-text-color-primary-hover: var(--color-50-fg) !important;
+  --button-text-color-primary-active: var(--color-40-fg) !important;
+  --color-accent-attention: var(--color-60) !important;
+  --color-accent-primary: var(--color-60) !important;
+  --focus-outline-color: var(--color-60) !important;
+  --icon-color: var(--neutral-default-70, var(--neutral-70)) !important;
+  --icon-color-critical: var(--red-60) !important;
+  --icon-color-information: var(--color-60) !important;
+  --icon-color-success: var(--success-60) !important;
+  --icon-color-warning: var(--warning-60) !important;
+  --input-text-background-color: var(--neutral-default-5, var(--neutral-5)) !important;
+  --input-text-border-color: var(--neutral-default-18, var(--neutral-18)) !important;
+  --input-text-border-radius: var(--radius-s) !important;
+  --input-text-color: var(--neutral-default-90, var(--neutral-90)) !important;
+  --input-text-min-height: var(
+    --bento-sidebar-address-row-height-px,
+    32px
+  ) !important;
+  --link-color: var(--neutral-default-80, var(--neutral-80)) !important;
+  --panel-background: var(--neutral-default-10, var(--neutral-10)) !important;
+  --panel-border-color: var(--neutral-default-20, var(--neutral-20)) !important;
+  --panel-color: var(--neutral-default-90, var(--neutral-90)) !important;
+  --panel-shadow: var(--shadow-l) !important;
+  --sidebar-background-color: var(--neutral-default-5, var(--neutral-5)) !important;
+  --sidebar-box-background: var(--neutral-default-10, var(--neutral-10)) !important;
+  --sidebar-box-border: 1px solid var(--neutral-default-20, var(--neutral-20)) !important;
+  --sidebar-box-border-color: var(--neutral-default-20, var(--neutral-20)) !important;
+  --sidebar-box-color: var(--neutral-default-90, var(--neutral-90)) !important;
+  --sidebar-text-color: var(--neutral-default-90, var(--neutral-90)) !important;
+  --text-color: var(--neutral-default-90, var(--neutral-90)) !important;
+  --text-color-deemphasized: var(--neutral-default-70, var(--neutral-70)) !important;
+  background-color: var(--background-color-canvas) !important;
+  color: var(--text-color) !important;
+}
+
+html,
+body {
+  color-scheme: light !important;
+  background-color: var(--background-color-canvas) !important;
+  color: var(--text-color) !important;
+}
+
 /* Use the system font like the other sidebar panels, so rem-based spacing
  * matches theirs (overriding common.css). Content size is kept via `body`. */
 :root:not(.system-font-size) {
@@ -21,6 +95,8 @@ body {
   display: flex;
   flex-direction: column;
   padding: var(--space-medium);
+  background-color: var(--background-color-canvas) !important;
+  color: var(--text-color) !important;
 }
 
 /* Password Card styles */
diff --git a/toolkit/components/satchel/megalist/content/megalist.html b/toolkit/components/satchel/megalist/content/megalist.html
index fab98e02263a808f5660c00ce1e890101f3074c6..f4018c2371ee28765106b1202239f6e9bcc9aed5 100644
--- a/toolkit/components/satchel/megalist/content/megalist.html
+++ b/toolkit/components/satchel/megalist/content/megalist.html
@@ -3,13 +3,14 @@
    - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
 
 <!doctype html>
-<html lang="en">
+<html lang="en" data-color-mode="light" data-theme="light">
   <head>
     <meta charset="utf-8" />
     <meta
       name="viewport"
       content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
     />
+    <meta name="color-scheme" content="light" />
     <meta
       http-equiv="Content-Security-Policy"
       content="default-src chrome: resource:;"
@@ -26,6 +27,10 @@
       href="chrome://browser/content/sidebar/sidebar.css"
     />
     <link rel="stylesheet" href="chrome://global/skin/in-content/common.css" />
+    <link
+      rel="stylesheet"
+      href="chrome://browser/content/bento-chrome-tokens.css"
+    />
     <link
       rel="stylesheet"
       href="chrome://global/content/megalist/megalist.css"
-- 
