From 1fe636bc028ada88114edc47b8f886f494ab9380 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Wed, 4 Nov 2026 18:26:19 +1100
Subject: [PATCH] Package distribution add-ons in a build not made by Mozilla

---
 browser/installer/package-manifest.in | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/browser/installer/package-manifest.in b/browser/installer/package-manifest.in
index 04bd23515eb4505cee3d9752db6388c4961ec315..c6524d723e19da2f201c3c535620555b4f8b5f44 100644
--- a/browser/installer/package-manifest.in
+++ b/browser/installer/package-manifest.in
@@ -472,4 +472,8 @@ bin/libfreebl_64int_3.so
 
 #if defined(BUILT_BY_MOZILLA)
 @RESPATH@/distribution/*
+#else
+; Bento ships uBlock Origin's signed XPI here. Firefox installs it into the
+; profile at startup. distribution.ini stays Mozilla-only.
+@RESPATH@/distribution/extensions/*
 #endif
