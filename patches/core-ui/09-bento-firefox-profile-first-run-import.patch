+export class ZenProfileMigrator extends FirefoxProfileMigrator {
+  static get key() {
+    return "zen";
+  }
+
+  static get displayNameL10nID() {
+    return "migration-wizard-migrator-display-name-zen";
+  }
+
+  static get brandImage() {
+    return (
+      getInstalledMacAppIconURL(["Zen.app", "Zen Browser.app"]) ??
+      "chrome://global/skin/icons/defaultFavicon.svg"
+    );
+  }
+
+  async getAllProfiles() {
+    return this._getProfilesFromRegistry(this._getZenDataRoot(), "Zen Browser");
+  }
+
+  getResourcesInternal(sourceProfileDir, currentProfileDir) {
+    let resources = super.getResourcesInternal(sourceProfileDir, currentProfileDir);
+    let zenSessionFile = this._getZenSessionFile(sourceProfileDir);
+    if (!zenSessionFile) {
+      return resources;
+    }
+
+    let types = MigrationUtils.resourceTypes;
+    resources.push({
+      name: "zen-session",
+      type: types.SESSION,
+      migrate: async aCallback => {
+        try {
+          let zenState = await IOUtils.readJSON(zenSessionFile.path, {
+            decompress: true,
+          });
+          let bentoState = this._convertZenSessionToFirefoxSession(zenState);
+          if (!bentoState) {
+            aCallback(true);
+            return;
+          }
+
+          let targetPath = PathUtils.join(
+            currentProfileDir.path,
+            "sessionstore.jsonlz4"
+          );
+          await IOUtils.writeJSON(targetPath, bentoState, {
+            compress: true,
+            tmpPath: `${targetPath}.tmp`,
+          });
+          let liveRestored = await this._restoreZenSessionToLiveBrowser(
+            bentoState
+          );
+          if (!liveRestored) {
+            Services.prefs.setBoolPref(
+              "browser.sessionstore.resume_session_once",
+              true
+            );
+            this._savePrefsToProfile(currentProfileDir);
+          }
+          aCallback(true);
+        } catch (ex) {
+          console.error("Could not import Zen session data", ex);
+          aCallback(false);
+        }
+      },
+    });
+
+    return resources;
+  }
+
+  _getZenDataRoot() {
+    if (AppConstants.platform != "macosx") {
+      return null;
+    }
+
+    let dir;
+    try {
+      dir = Services.dirsvc.get("ULibDir", Ci.nsIFile);
+      dir.append("Application Support");
+      dir.append("zen");
+    } catch (ex) {
+      console.error("Could not resolve Zen profile root for migration", ex);
+      return null;
+    }
+
+    return dir;
+  }
+
+  _getZenSessionFile(profileDir) {
+    let primary = this._getFileObject(profileDir, "zen-sessions.jsonlz4");
+    if (primary) {
+      return primary;
+    }
+
+    let backupDir = this._getFileObject(profileDir, "zen-sessions-backup");
+    if (!backupDir?.isDirectory()) {
+      return null;
+    }
+    let backup = backupDir.clone();
+    backup.append("clean.jsonlz4");
+    return backup.exists() && backup.isReadable() ? backup : null;
+  }
+
+  async _restoreZenSessionToLiveBrowser(bentoState) {
+    if (!Services.wm.getMostRecentWindow("navigator:browser")) {
+      return false;
+    }
+    try {
+      await lazy.SessionStore.promiseInitialized;
+      lazy.SessionStore.setBrowserState(JSON.stringify(bentoState));
+      if (
+        Services.prefs.prefHasUserValue(
+          "browser.sessionstore.resume_session_once"
+        )
+      ) {
+        Services.prefs.clearUserPref("browser.sessionstore.resume_session_once");
+      }
+      return true;
+    } catch (ex) {
+      console.error("Could not restore Zen session into live browser", ex);
+      return false;
+    }
+  }
+
+  _savePrefsToProfile(profileDir) {
+    let newPrefsFile = profileDir.clone();
+    newPrefsFile.append("prefs.js");
+    Services.prefs.savePrefFile(newPrefsFile);
+  }
+
+  _convertZenSessionToFirefoxSession(zenState) {
+    if (!zenState || typeof zenState != "object") {
+      return null;
+    }
+
+    let zenSpaces = Array.isArray(zenState.spaces) ? zenState.spaces : [];
+    let zenTabs = Array.isArray(zenState.tabs) ? zenState.tabs : [];
+    let now = Date.now();
+    let workspaceByZenId = new Map();
+    let importedWorkspaces = [];
+
+    for (let i = 0; i < zenSpaces.length; i++) {
+      let space = zenSpaces[i];
+      if (!space || typeof space != "object") {
+        continue;
+      }
+      let id =
+        typeof space.uuid == "string" && space.uuid
+          ? space.uuid
+          : `zen-imported-space-${i + 1}`;
+      let name =
+        typeof space.name == "string" && space.name.trim()
+          ? space.name.trim()
+          : `Space ${i + 1}`;
+      let workspace = { id, name, createdAt: now + importedWorkspaces.length };
+      if (typeof space.icon == "string" && space.icon.trim()) {
+        workspace.icon = space.icon.trim();
+      }
+      workspaceByZenId.set(id, workspace);
+      importedWorkspaces.push(workspace);
+    }
+
+    let defaultWorkspace =
+      importedWorkspaces[0] ??
+      {
+        id: "zen-imported-space-1",
+        name: "Zen",
+        createdAt: now,
+      };
+    if (!importedWorkspaces.length) {
+      importedWorkspaces.push(defaultWorkspace);
+    }
+
+    let tabsByWorkspace = new Map(importedWorkspaces.map(w => [w.id, []]));
+    for (let tab of zenTabs) {
+      let converted = this._convertZenTab(tab);
+      if (!converted) {
+        continue;
+      }
+      let workspaceId =
+        typeof tab.zenWorkspace == "string" && workspaceByZenId.has(tab.zenWorkspace)
+          ? tab.zenWorkspace
+          : defaultWorkspace.id;
+      converted.extData = {
+        "extension:bento-tools@bento.app:bento.workspaceId":
+          JSON.stringify(workspaceId),
+      };
+      if (converted.__zenEssential) {
+        converted.extData["extension:bento-tools@bento.app:bento.isPanel"] =
+          JSON.stringify(
+            JSON.stringify({
+              version: 2,
+              workspaceId,
+              rootIndex: tabsByWorkspace.get(workspaceId)?.length ?? 0,
+              pinnedPanel: true,
+            })
+          );
+        converted.extData[
+          "extension:bento-tools@bento.app:bento.importPinnedPanel"
+        ] = JSON.stringify(true);
+      }
+      tabsByWorkspace.get(workspaceId)?.push(converted);
+    }
+
+    let firefoxTabs = [];
+    for (let workspace of importedWorkspaces) {
+      let workspaceTabs = tabsByWorkspace.get(workspace.id) ?? [];
+      workspaceTabs.sort((a, b) => {
+        if (a.pinned != b.pinned) {
+          return a.pinned ? -1 : 1;
+        }
+        return (a.__zenIndex ?? 0) - (b.__zenIndex ?? 0);
+      });
+      for (let tab of workspaceTabs) {
+        delete tab.__zenIndex;
+        delete tab.__zenEssential;
+        firefoxTabs.push(tab);
+      }
+    }
+
+    if (!firefoxTabs.length) {
+      return null;
+    }
+
+    let activeWorkspaceId =
+      importedWorkspaces.find(w => (tabsByWorkspace.get(w.id) ?? []).length > 0)
+        ?.id ?? importedWorkspaces[0].id;
+    let selected =
+      firefoxTabs.findIndex(
+        tab =>
+          !tab.pinned &&
+          !tab.extData?.["extension:bento-tools@bento.app:bento.isPanel"]
+      ) +
+        1 ||
+      firefoxTabs.findIndex(tab => !tab.pinned) + 1 ||
+      1;
+
+    return {
+      version: ["sessionrestore", 1],
+      windows: [
+        {
+          tabs: firefoxTabs,
+          selected,
+          _closedTabs: [],
+          extData: {
+            "extension:bento-tools@bento.app:bento.activeWorkspaceId":
+              JSON.stringify(activeWorkspaceId),
+            "extension:bento-tools@bento.app:bento.importedWorkspaces":
+              JSON.stringify(importedWorkspaces),
+          },
+        },
+      ],
+      selectedWindow: 1,
+      _closedWindows: [],
+      session: {
+        lastUpdate: now,
+        startTime: now,
+        recentCrashes: 0,
+      },
+    };
+  }
+
+  _convertZenTab(tab) {
+    if (
+      !tab ||
+      typeof tab != "object" ||
+      tab.hidden === true ||
+      tab.private === true ||
+      tab.isPrivate === true ||
+      tab.incognito === true
+    ) {
+      return null;
+    }
+    let entries = Array.isArray(tab.entries) ? tab.entries : [];
+    if (!entries.length) {
+      return null;
+    }
+    let index =
+      typeof tab.index == "number" && tab.index > 0 && tab.index <= entries.length
+        ? Math.floor(tab.index)
+        : entries.length;
+    let entry = entries[index - 1];
+    if (
+      entry?.private === true ||
+      entry?.isPrivate === true ||
+      entry?.incognito === true
+    ) {
+      return null;
+    }
+    let url = entry?.url;
+    if (typeof url != "string" || !url || url == "about:blank") {
+      return null;
+    }
+
+    return {
+      entries,
+      index,
+      pinned: tab.pinned === true && tab.zenEssential !== true,
+      userContextId:
+        typeof tab.userContextId == "number" && tab.userContextId >= 0
+          ? tab.userContextId
+          : 0,
+      lastAccessed:
+        typeof tab.lastAccessed == "number" && Number.isFinite(tab.lastAccessed)
+          ? tab.lastAccessed
+          : Date.now(),
+      attributes:
+        tab.attributes && typeof tab.attributes == "object"
+          ? tab.attributes
+          : {},
+      __zenIndex:
+        typeof tab.index == "number" && Number.isFinite(tab.index)
+          ? tab.index
+          : 0,
+      __zenEssential: tab.zenEssential === true,
+    };
+  }
+}
