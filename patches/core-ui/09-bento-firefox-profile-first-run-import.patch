+  }
+
+  let roots = ["/Applications"];
+  try {
+    let home = Services.dirsvc.get("Home", Ci.nsIFile);
+    let userApplications = home.clone();
+    userApplications.append("Applications");
+    roots.push(userApplications.path);
+  } catch {
+    // The system Applications folder is still worth checking.
+  }
+
+  for (let root of roots) {
+    for (let bundleName of bundleNames) {
+      try {
+        let file = Cc["@mozilla.org/file/local;1"].createInstance(Ci.nsIFile);
+        file.initWithPath(`${root}/${bundleName}`);
+        if (file.exists() && file.isDirectory()) {
+          let fileHandler = Services.io
+            .getProtocolHandler("file")
+            .QueryInterface(Ci.nsIFileProtocolHandler);
+          return `moz-icon://${fileHandler.getURLSpecFromActualFile(file)}?size=32`;
+        }
+      } catch {
+        // Try the next known bundle name/location.
+      }
+    }
+  }
+  return null;
