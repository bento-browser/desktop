+  /**
+   * Return profiles from Mozilla Firefox's profile registry when Bento is the
+   * running app. Bento has its own profile registry, so nsIToolkitProfileService
+   * would otherwise enumerate only Bento profiles and the startup migration
+   * wizard would not offer the user's existing Firefox profiles.
+   *
+   * @returns {Map<string, object>} A map keyed by absolute Firefox profile path.
+   */
+  getAllMozillaFirefoxProfiles() {
+    let firefoxRoot = this._getMozillaFirefoxDataRoot();
+    return this._getProfilesFromRegistry(firefoxRoot, "Firefox");
+  }
+
+  _getProfilesFromRegistry(profileRoot, sourceName) {
+    let allProfiles = new Map();
+    if (!profileRoot) {
+      return allProfiles;
+    }
+
+    let profilesIni = profileRoot.clone();
+    profilesIni.append("profiles.ini");
+    if (!profilesIni.exists() || !profilesIni.isReadable()) {
+      return allProfiles;
+    }
+
+    let parser;
+    try {
+      parser = Cc["@mozilla.org/xpcom/ini-parser-factory;1"]
+        .getService(Ci.nsIINIParserFactory)
+        .createINIParser(profilesIni);
+    } catch (ex) {
+      console.error(`Could not read ${sourceName} profiles.ini for migration`, ex);
+      return allProfiles;
+    }
+
+    let currentProfileDir = MigrationUtils.profileStartup?.directory;
+    let sections = parser.getSections();
+    while (sections.hasMore()) {
+      let section = sections.getNext();
+      if (!section.startsWith("Profile")) {
+        continue;
+      }
+
+      let name = this._safeGet(parser, section, "Name");
+      let path = this._safeGet(parser, section, "Path");
+      let isRelative = this._safeGet(parser, section, "IsRelative");
+      if (!name || !path) {
+        continue;
+      }
+
+      let rootDir = this._getProfileDirFromDescriptor(
+        profileRoot,
+        path,
+        isRelative == "1"
+      );
+      if (
+        rootDir?.exists() &&
+        rootDir.isReadable() &&
+        (!currentProfileDir || !rootDir.equals(currentProfileDir))
+      ) {
+        allProfiles.set(rootDir.path, {
+          id: rootDir.path,
+          name,
+          rootDir,
+        });
+      }
+    }
+
+    return allProfiles;
+  }
+
+  _getMozillaFirefoxDataRoot() {
+    let dir;
+    try {
+      if (AppConstants.platform == "win") {
+        dir = Services.dirsvc.get("AppData", Ci.nsIFile);
+        dir.append("Mozilla");
+        dir.append("Firefox");
+      } else if (AppConstants.platform == "macosx") {
+        dir = Services.dirsvc.get("ULibDir", Ci.nsIFile);
+        dir.append("Application Support");
+        dir.append("Firefox");
+      } else {
+        dir = Services.dirsvc.get("Home", Ci.nsIFile);
+        dir.append(".mozilla");
+        dir.append("firefox");
+      }
+    } catch (ex) {
+      console.error("Could not resolve Firefox profile root for migration", ex);
+      return null;
+    }
+
+    return dir;
+  }
+
+  _getProfileDirFromDescriptor(parentDir, descriptor, isRelative) {
+    try {
+      if (!isRelative) {
+        let file = Cc["@mozilla.org/file/local;1"].createInstance(Ci.nsIFile);
+        file.initWithPath(descriptor);
+        return file;
+      }
+
+      let file = parentDir.clone();
+      for (let part of descriptor.split(/[\\/]+/)) {
+        if (part) {
+          file.append(part);
+        }
+      }
+      return file;
+    } catch (ex) {
+      console.error("Could not resolve Firefox profile path for migration", ex);
+      return null;
+    }
+  }
+
+  _safeGet(parser, section, key) {
+    try {
+      return parser.getString(section, key);
+    } catch {
+      return null;
+    }
+  }
+
   async getSourceProfiles() {
