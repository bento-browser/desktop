 toolkit/content/widgets/infobar.css | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/toolkit/content/widgets/infobar.css b/toolkit/content/widgets/infobar.css
index 7e01bd113c3eb0888aee1ab1d31ba5174c7acc3c..8134a4ec0aaa9a2d6fff6d96465952a6b02580d7 100644
--- a/toolkit/content/widgets/infobar.css
+++ b/toolkit/content/widgets/infobar.css
@@ -65,7 +65,10 @@
     color: var(--info-bar-text-color);
 
     &::before {
-      background-image: linear-gradient(0deg, #9059ff 0%, #ff4aa2 52.08%, #ffbd4f 100%);
+      background-image: var(
+        --info-bar-accent-background,
+        linear-gradient(0deg, #9059ff 0%, #ff4aa2 52.08%, #ffbd4f 100%)
+      );
     }
   }
 }
