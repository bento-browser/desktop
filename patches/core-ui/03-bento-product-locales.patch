From 8805cda668e5529af2ea74aa759d95cee234bb36 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Wed, 24 Jun 2026 19:23:31 +1000
Subject: [PATCH] Set Bento product locale strings

---
 .../en-US/toolkit/branding/brandings.ftl       | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/toolkit/locales/en-US/toolkit/branding/brandings.ftl b/toolkit/locales/en-US/toolkit/branding/brandings.ftl
index 97f695334a1f342fd1d37b41aec0ab161bdf0d5d..cddc32239efe3b2d39ca791aba9a5ec8ce16f1fd 100644
--- a/toolkit/locales/en-US/toolkit/branding/brandings.ftl
+++ b/toolkit/locales/en-US/toolkit/branding/brandings.ftl
@@ -40,20 +40,20 @@
 # The particle "by" can be localized, "Fakespot" and "Mozilla" should not be localized or transliterated.
 -fakespot-brand-full-name = Fakespot by Mozilla
 
-# “Suggest” can be localized, “Firefox” must be treated as a brand
+# “Suggest” can be localized, “Bento” must be treated as a brand
 # and kept in English.
--firefox-suggest-brand-name = Firefox Suggest
+-firefox-suggest-brand-name = Bento Suggest
 
-# ”Home" can be localized, “Firefox” must be treated as a brand
+# ”Home" can be localized, “Bento” must be treated as a brand
 # and kept in English.
--firefox-home-brand-name = Firefox Home
+-firefox-home-brand-name = Bento Home
 
-# View" can be localized, “Firefox” must be treated as a brand
+# View" can be localized, “Bento” must be treated as a brand
 # and kept in English.
--firefoxview-brand-name = Firefox View
+-firefoxview-brand-name = Bento View
 
-# Firefox Labs is the name for a page in Settings to allow users to learn about
+# Bento Labs is the name for a page in Settings to allow users to learn about
 # experimental and in-development features, and turn those features on and off.
-# The "Labs" portion can be localized, “Firefox” must be treated as a brand
+# The "Labs" portion can be localized, “Bento” must be treated as a brand
 # and kept in English.
--firefoxlabs-brand-name = Firefox Labs
+-firefoxlabs-brand-name = Bento Labs
-- 
