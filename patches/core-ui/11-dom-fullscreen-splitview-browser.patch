From 56d71d9bfe6dfa4cc39bd5d24b5c6ae923d4b278 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Sat, 27 Jun 2026 16:35:00 +1000
Subject: [PATCH] Allow DOM fullscreen from split view browsers

---
 .../browser-fullScreenAndPointerLock.js       | 22 ++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/browser/base/content/browser-fullScreenAndPointerLock.js b/browser/base/content/browser-fullScreenAndPointerLock.js
index 57711112f21a5929904fce26e44a8a7a2c85ecf4..4e128f3963b3653d25b76c955e73664e86e9056d 100644
--- a/browser/base/content/browser-fullScreenAndPointerLock.js
+++ b/browser/base/content/browser-fullScreenAndPointerLock.js
@@ -634,13 +634,13 @@ var FullScreen = {
       }
     }
 
-    // If we've received a fullscreen notification, we have to ensure that the
-    // element that's requesting fullscreen belongs to the browser that's currently
-    // active. If not, we exit fullscreen since the "full-screen document" isn't
-    // actually visible now.
+    // If we've received a fullscreen notification, ensure the requesting
+    // element belongs to one of the browsers currently active in the window.
+    // This includes split-view browsers, which can be visible even when they
+    // are not gBrowser.selectedBrowser.
     if (
       !aBrowser ||
-      gBrowser.selectedBrowser != aBrowser ||
+      !gBrowser.selectedBrowsers.includes(aBrowser) ||
       // The top-level window has lost focus since the request to enter
       // full-screen was made. Cancel full-screen.
       Services.focus.activeWindow != window
@@ -649,6 +649,12 @@ var FullScreen = {
       return;
     }
 
+    try {
+      window.BentoShellDomFullscreen?.markRequesterForBrowser?.(aBrowser);
+    } catch (ex) {
+      Cu.reportError(ex);
+    }
+
     // Remove permission prompts when entering full-screen.
     if (!FullScreen.permissionsFullScreenAllowed) {
       let notifications = PopupNotifications.getNotification(
@@ -778,6 +784,12 @@ var FullScreen = {
       this._isChromeCollapsed
     );
 
+    try {
+      window.BentoShellDomFullscreen?.clearRequester?.();
+    } catch (ex) {
+      Cu.reportError(ex);
+    }
+
     return needToWaitForChildExit;
   },
 
