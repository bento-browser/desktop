+    --page-nav-button-indicator-color: var(--color-60);
+    --page-nav-button-text-color: var(--neutral-80);
+    --page-nav-button-text-color-hover: var(--neutral-90);
+    --page-nav-button-text-color-active: var(--neutral-90);
+  }
