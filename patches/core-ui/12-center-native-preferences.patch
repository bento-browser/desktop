+@media not (forced-colors) {
+  #preferences-root,
+  #preferences-body {
+    background-color: var(--background-color-canvas);
+    color: var(--text-color);
+  }
+
+  /* Keep Firefox's light-dark() tokens on the same scheme as Bento's token
+     sheet, which follows data-color-mode (mirrored from the window root by
+     preferences.js). */
+  #preferences-root[data-color-mode="light"] {
+    color-scheme: light;
+  }
+
+  #preferences-root[data-color-mode="dark"] {
+    color-scheme: dark;
+  }
+
+  #categories {
+    --page-nav-border-color: var(--neutral-16);
