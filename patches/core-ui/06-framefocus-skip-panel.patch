From 392d971222451b5f92e94da4cbfe67476d9ed26a Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Wed, 24 Jun 2026 19:23:35 +1000
Subject: [PATCH] Skip Bento panel browsers in frame focus

---
 browser/components/tabbrowser/Tabbrowser.sys.mjs | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/browser/components/tabbrowser/Tabbrowser.sys.mjs b/browser/components/tabbrowser/Tabbrowser.sys.mjs
index 241875edde94e674713d6651704e19a142c40b5d..c85785fc4e4e8e5104ecbef8fce50e51cabe7eb2 100644
--- a/browser/components/tabbrowser/Tabbrowser.sys.mjs
+++ b/browser/components/tabbrowser/Tabbrowser.sys.mjs
@@ -9306,6 +9306,15 @@ export class Tabbrowser {
       // preventDefault(). It will still raise the window if appropriate.
       return;
     }
+    // Bento: panel tabs are always visible in the side-panel strip.
+    // Promoting one to selectedTab triggers bento-tools' revert path
+    // (tabs.onActivated → tabs.update back to the previous main),
+    // which fires a TabSelect cascade and scrolls the strip to main.
+    // Observed on DevTools close: the inspected panel browser regains
+    // focus, fires framefocusrequested, and starts the cascade.
+    if (tab.linkedBrowser?.closest?.("[data-bento-panel-tab-id]")) {
+      return;
+    }
     this.selectedTab = tab;
     this.documentGlobal.focus();
     aEvent.preventDefault();
