From 1a7d465427cfaebe7d62b964159af5886e3a1732 Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Mon, 12 Oct 2026 07:04:08 +1100
Subject: [PATCH] Hide the About updates group when the updater is not built in

---
 .../preferences/config/about-firefox.mjs       |  5 +++++
 .../tests/browser_updates_managed_by_os.js     | 18 ++++++++++++++++--
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/browser/components/preferences/config/about-firefox.mjs b/browser/components/preferences/config/about-firefox.mjs
index c28905c8da122b090b52b540194e4c0a5c56f0c1..13c8e4ad08ca9f2027e0ecddea6a3555f7bcbf88 100644
--- a/browser/components/preferences/config/about-firefox.mjs
+++ b/browser/components/preferences/config/about-firefox.mjs
@@ -478,6 +478,11 @@ SettingGroupManager.registerGroups({
     iconSrc: "chrome://browser/skin/update-badge.svg",
     subcategory: "update-state",
     headingLevel: 2,
+    // Bento builds without the updater: hide the group and keep it out of
+    // Settings search. Its "managed by your operating system" message would be
+    // false for Bento.
+    hidden: !AppConstants.MOZ_UPDATER,
+    hiddenFromSearch: !AppConstants.MOZ_UPDATER,
     items: [
       {
         id: "updatesManagedByOS",
diff --git a/browser/components/preferences/tests/browser_updates_managed_by_os.js b/browser/components/preferences/tests/browser_updates_managed_by_os.js
index aee2b9137aa76ed2506cf95893ee7d663fe21995..7fd9fdc382c44fe6362e61b40e453a9aff6fd2e7 100644
--- a/browser/components/preferences/tests/browser_updates_managed_by_os.js
+++ b/browser/components/preferences/tests/browser_updates_managed_by_os.js
@@ -16,11 +16,25 @@ add_task(async function test_updates_managed_by_os_message_bar() {
   let updatesManagedByOSMessageBar = updatesManagedByOSControl.controlEl;
 
   let isPackagedApp = Services.sysinfo.getProperty("isPackagedApp");
+  // Bento hides the whole updates group when the updater is not built in, so
+  // the message bar shows only for a packaged app that has an updater.
   is(
     BrowserTestUtils.isHidden(updatesManagedByOSMessageBar),
-    win.AppConstants.MOZ_UPDATER && !isPackagedApp,
-    "updatesManagedByOS message bar is shown only when running as a packaged app"
+    !(win.AppConstants.MOZ_UPDATER && isPackagedApp),
+    "updatesManagedByOS message bar is shown only when running as a packaged app with the updater built in"
   );
+  if (!win.AppConstants.MOZ_UPDATER) {
+    let group = updatesManagedByOSControl.closest("setting-group");
+    ok(
+      BrowserTestUtils.isHidden(group),
+      "The updates group is hidden when the updater is not built in"
+    );
+    is(
+      group.getAttribute("data-hidden-from-search"),
+      "true",
+      "The updates group is hidden from Settings search when the updater is not built in"
+    );
+  }
 
   if (win.AppConstants.MOZ_UPDATER && !isPackagedApp) {
     let updateRadioGroupControl = await settingControlRenders(
-- 
