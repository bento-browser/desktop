From 2cebecc3cc175951fc3669e3e72fa863d8a073ae Mon Sep 17 00:00:00 2001
From: Bento Patch Stack <patch-stack@bentobrowser.invalid>
Date: Wed, 24 Jun 2026 19:23:32 +1000
Subject: [PATCH] Support inspecting panel browsers

---
 browser/base/content/nsContextMenu.sys.mjs | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/browser/base/content/nsContextMenu.sys.mjs b/browser/base/content/nsContextMenu.sys.mjs
index 59efe0fc1edf98179cd5fdaa2427c407f6a9a71b..22eda54acd5b7b4d5622a5f37c941ce47f61fc95 100644
--- a/browser/base/content/nsContextMenu.sys.mjs
+++ b/browser/base/content/nsContextMenu.sys.mjs
@@ -1422,15 +1422,22 @@ export class nsContextMenu {
   }
 
   inspectNode() {
+    // Bento: each panel is a tab whose <browser> was re-parented into the
+    // side-panel deck. ContextMenuParent sets contentData.browser (mirrored
+    // here as this.browser) to the panel's browser, but selectedTab is
+    // always the main tab — resolve the tab from the browser so DevTools
+    // opens for the panel content the user actually right-clicked in.
     return lazy.DevToolsShim.inspectNode(
-      this.window.gBrowser.selectedTab,
+      this.window.gBrowser.getTabForBrowser(this.browser) ||
+        this.window.gBrowser.selectedTab,
       this.targetIdentifier
     );
   }
 
   inspectA11Y() {
     return lazy.DevToolsShim.inspectA11Y(
-      this.window.gBrowser.selectedTab,
+      this.window.gBrowser.getTabForBrowser(this.browser) ||
+        this.window.gBrowser.selectedTab,
       this.targetIdentifier
     );
   }
