--- a/browser/components/aboutlogins/content/aboutLogins.html
+++ b/browser/components/aboutlogins/content/aboutLogins.html
@@ -29,6 +29,7 @@
     <script type="module" src="chrome://browser/content/aboutlogins/aboutLogins.mjs"></script>
     <link rel="stylesheet" href="chrome://global/skin/in-content/common.css">
     <link rel="stylesheet" href="chrome://browser/content/aboutlogins/aboutLogins.css">
+    <link rel="stylesheet" href="chrome://browser/content/bento-chrome-tokens.css">
     <link rel="stylesheet" href="chrome://browser/content/aboutlogins/common.css">
     <link rel="icon" href="chrome://branding/content/icon32.png">
   </head>
diff --git a/browser/components/aboutlogins/content/aboutLoginsImportReport.html b/browser/components/aboutlogins/content/aboutLoginsImportReport.html
index 6a6932502d8eb82c70e6aea039580f489224ee60..638704664537eee21d5eee494f7610af1f425e31 100644
--- a/browser/components/aboutlogins/content/aboutLoginsImportReport.html
+++ b/browser/components/aboutlogins/content/aboutLoginsImportReport.html
@@ -28,6 +28,10 @@
       rel="stylesheet"
       href="chrome://browser/content/aboutlogins/aboutLoginsImportReport.css"
     />
+    <link
+      rel="stylesheet"
+      href="chrome://browser/content/bento-chrome-tokens.css"
+    />
     <link
       rel="stylesheet"
       href="chrome://browser/content/aboutlogins/common.css"
diff --git a/browser/components/aboutlogins/content/common.css b/browser/components/aboutlogins/content/common.css
index 2771a6b03e0cd4605190c9f33678c346f1e7a52b..7e8de6111612cd07df79dd4b7454de19e7f9d8e8 100644
--- a/browser/components/aboutlogins/content/common.css
+++ b/browser/components/aboutlogins/content/common.css
@@ -2,6 +2,18 @@
  * License, v. 2.0. If a copy of the MPL was not distributed with this
  * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
 
+/* Bento: shapes and elevation from bento-chrome-tokens.css. Colours come from
+ * the registered bento-about-themes.css sheet. */
+:root,
+:host {
+  --border-radius-small: var(--radius-s) !important;
+  --border-radius-medium: var(--radius-m) !important;
+  --border-radius-circle: var(--radius-full) !important;
+  --border-width: 1px !important;
+  --box-shadow-level-2: var(--shadow-l) !important;
+  --popup-box-shadow: var(--shadow-l) !important;
+}
+
 /* [hidden] isn't applying to elements in Shadow DOM. */
 :host([hidden]),
 [hidden] {
diff --git a/browser/components/aboutlogins/content/components/login-message-popup.css b/browser/components/aboutlogins/content/components/login-message-popup.css
index c443a1e3acdec651882bac0a6297bfe74893837a..4e62961d0626bd92a6edd5d3493c23e7f5f04503 100644
--- a/browser/components/aboutlogins/content/components/login-message-popup.css
+++ b/browser/components/aboutlogins/content/components/login-message-popup.css
@@ -6,7 +6,7 @@
   position: absolute;
   inset-inline-start: 315px;
   width: 232px;
-  box-shadow: 2px 2px 10px 1px rgba(0, 0, 0, 0.18);
+  box-shadow: var(--shadow-l);
   top: 0;
 }
 
