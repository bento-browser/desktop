+async function importFile() {
+  let picker = Cc["@mozilla.org/filepicker;1"].createInstance(Ci.nsIFilePicker);
+  picker.init(
+    window.browsingContext,
+    await document.l10n.formatValue("bento-backup-import-title"),
+    Ci.nsIFilePicker.modeOpen
+  );
+  picker.appendFilter("JSON", "*.json");
+  if ((await new Promise(resolve => picker.open(resolve))) === Ci.nsIFilePicker.returnCancel) {
+    return;
+  }
+  let stat = await IOUtils.stat(picker.file.path);
+  if (stat.size > 10 * 1024 * 1024) {
+    throw new Error("payload_too_large");
+  }
+  let json = await IOUtils.readUTF8(picker.file.path);
+  let validated = await model.request("backup/validateImport", { json });
+  let confirmed = Services.prompt.confirm(
+    window,
+    await document.l10n.formatValue("bento-backup-import-confirm-title"),
+    await document.l10n.formatValue("bento-backup-import-confirm", {
+      workspaces: validated.preview.totals.workspaceCount,
+      tabs: validated.preview.totals.normalTabCount,
+    })
+  );
+  if (!confirmed) {
+    return;
+  }
+  await model.request(
+    "backup/importValidated",
+    {
+      validationToken: validated.validationToken,
+      options: {
+        importSettings: validated.preview.hasSettings,
+        importSavedPanels: validated.preview.savedPanelCount > 0,
+        replaceExisting: false,
+      },
+    },
+    { operationId: crypto.randomUUID() }
+  );
+}
