+      let generation = ++this.#renderGeneration;
+      let query = queryValue.toLowerCase();
+      let values = await document.l10n.formatValues(
+        SHORTCUTS.flatMap(row => [{ id: row.labelId }, { id: row.keysId }])
+      );
+      let localized = SHORTCUTS.map((row, index) => ({
+        ...row,
+        label: values[index * 2],
+        keys: values[index * 2 + 1],
+      }));
+      let matches = localized.filter(row =>
+        `${row.label} ${row.keys}`.toLowerCase().includes(query)
+      );
+      if (generation !== this.#renderGeneration) {
+        return;
+      }
+      document.l10n.setAttributes(count, "bento-shortcuts-results", {
+        count: matches.length,
+      });
+      list.replaceChildren(count);
+      for (let row of matches) {
+        let item = document.createElement("moz-box-item");
+        item.label = row.label;
+        item.description = row.keys;
+        list.append(item);
+      }
+    };
+    search.addEventListener("MozInputSearch:search", event => {
+      void render(event.detail.query);
+    });
+    this.append(search, list);
+    void render("");
+  }
