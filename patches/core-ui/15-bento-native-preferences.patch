+  display: grid;
+  grid-template-columns:
+    minmax(var(--size-layout-small), 1fr) var(--size-layout-xsmall);
+  align-items: end;
+  gap: var(--space-medium);
+  min-inline-size: var(--size-layout-small);
+}
+
+bento-size-list {
+  display: grid;
+  gap: var(--space-medium);
+}
+
