+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+add_task(async function test_bento_backup_subpane_route() {
+  await openPreferencesViaOpenPreferencesAPI("bentoBackups", {
+    leaveOpen: true,
+  });
+  let doc = gBrowser.contentDocument;
+  await TestUtils.waitForCondition(
+    () => doc.querySelector('setting-pane[data-category="paneBentoBackups"]'),
+    "Bento backup subpane registered"
+  );
+  is(
+    doc.location.hash,
+    "#bentoBackups",
+    "Backup management has its native subpane route"
+  );
+  let manager = doc.querySelector("bento-backup-manager");
+  ok(manager, "Stored backup restore and delete manager is native");
+  await TestUtils.waitForCondition(
+    () => manager.querySelector("moz-box-group"),
+    "Stored backups native list rendered"
+  );
+  is(
+    manager.querySelector("moz-box-group").type,
+    "list",
+    "Stored backups use Firefox's native list group"
+  );
+  is(
+    manager.querySelectorAll("button, article").length,
+    0,
+    "Backup controller does not render custom light-DOM entries or buttons"
+  );
+  BrowserTestUtils.removeTab(gBrowser.selectedTab);
+});
diff --git a/browser/components/preferences/tests/browser_bento_native_bridge.js b/browser/components/preferences/tests/browser_bento_native_bridge.js
new file mode 100644
