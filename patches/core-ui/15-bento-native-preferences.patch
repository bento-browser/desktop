+class BentoShortcutList extends HTMLElement {
+  #renderGeneration = 0;
+  connectedCallback() {
+    if (this.firstElementChild) {
+      return;
+    }
+    let search = document.createElement("moz-input-search");
+    search.setAttribute("data-l10n-id", "bento-shortcuts-search");
+    let count = document.createElement("moz-box-item");
+    count.slot = "header";
