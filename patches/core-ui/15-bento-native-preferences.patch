+  inline-size: var(--size-layout-xsmall);
+}
+
+.bento-visually-hidden {
+  position: absolute;
+  inline-size: 1px;
+  block-size: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+}
+
+bento-backup-manager {
+  display: grid;
+  gap: var(--space-medium);
+}
+
+bento-shortcut-list {
+  display: grid;
+  gap: var(--space-large);
+}
