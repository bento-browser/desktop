+class BentoBackupManager extends HTMLElement {
+  #unsubscribe;
+  #renderGeneration = 0;
+  connectedCallback() {
+    this.#unsubscribe ||= model.onChange(() => void this.#render());
+    void model.refresh(["backup"]);
+    void this.#render();
+  }
+  disconnectedCallback() {
+    this.#unsubscribe?.();
+    this.#unsubscribe = null;
+  }
+  async #act(operation, backup) {
+    let action = operation === "backup/delete" ? "delete" : "restore";
+    let [title, message] = await document.l10n.formatValues([
+      { id: `bento-backup-${action}-title` },
+      { id: `bento-backup-${action}-confirm` },
+    ]);
+    if (!Services.prompt.confirm(window, title, message)) {
+      return;
+    }
+    this.setAttribute("aria-busy", "true");
+    try {
+      await model.request(
+        operation,
+        {
+          backupId: backup.id,
+          ...(action === "delete" ? { confirm: true } : {}),
+        },
+        { operationId: crypto.randomUUID() }
+      );
+      await model.refresh(["backup"]);
+    } finally {
+      this.removeAttribute("aria-busy");
+    }
+  }
+  async #render() {
+    let generation = ++this.#renderGeneration;
+    let backups = model.snapshot("backup")?.backups ?? [];
+    let messages = [];
+    if (!backups.length) {
+      messages.push({ id: "bento-backup-empty" });
+    }
+    for (let backup of backups) {
+      messages.push({
+        id: "bento-backup-summary",
+        args: {
+          date: new Date(backup.createdAt).toLocaleString(),
+          workspaces: backup.workspaceCount,
+          tabs: backup.tabCount,
+        },
+      });
+      if (backup.privacySafety !== "private-filtered-v1") {
+        messages.push({ id: "bento-backup-legacy-unknown" });
+      }
+    }
+    let localized = await document.l10n.formatValues(messages);
+    let localizedIndex = 0;
+    let list = document.createElement("moz-box-group");
+    list.type = "list";
+    if (!backups.length) {
+      let empty = document.createElement("moz-box-item");
+      empty.label = localized[localizedIndex++];
+      list.append(empty);
+    }
+    for (let backup of backups) {
+      let item = document.createElement("moz-box-item");
+      item.label = localized[localizedIndex++];
+      if (backup.privacySafety !== "private-filtered-v1") {
+        item.description = localized[localizedIndex++];
+      }
+      let restore = document.createElement("moz-button");
+      restore.slot = "actions";
+      restore.size = "small";
+      restore.setAttribute("data-l10n-id", "bento-backup-restore");
+      restore.addEventListener(
+        "click",
+        () => void this.#act("backup/restore", backup)
+      );
+      let remove = document.createElement("moz-button");
+      remove.slot = "actions";
+      remove.size = "small";
+      remove.type = "destructive";
+      remove.setAttribute("data-l10n-id", "bento-backup-delete");
+      remove.addEventListener(
+        "click",
+        () => void this.#act("backup/delete", backup)
+      );
+      item.append(restore, remove);
+      list.append(item);
+    }
+    if (generation === this.#renderGeneration) {
+      this.replaceChildren(list);
+    }
+  }
+}
