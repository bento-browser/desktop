--- /dev/null
+++ b/browser/components/preferences/tests/browser_bento_native_bridge.js
@@ -0,0 +1,31 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+add_task(async function test_parent_registry_attestation_shape() {
+  let { BentoShellDocumentRegistry } = ChromeUtils.importESModule(
+    "resource:///actors/BentoShellDocumentRegistry.sys.mjs"
+  );
+  let first = BentoShellDocumentRegistry.getCurrentBootAttestation();
+  let second = BentoShellDocumentRegistry.getCurrentBootAttestation();
+  Assert.deepEqual(first, second, "Parent identity is stable in one process");
+  Assert.deepEqual(
+    Object.keys(first).sort(),
+    [
+      "currentBootId",
+      "currentParentSessionId",
+      "registryEpoch",
+      "singletonInitializedAt",
+    ],
+    "Attestation exposes only the closed current-parent shape"
+  );
+});
+
+add_task(async function test_generated_protocol_is_packaged() {
+  let protocol = ChromeUtils.importESModule(
+    "chrome://browser/content/preferences/bento/generated/BentoNativePreferencesProtocol.sys.mjs"
+  );
+  is(protocol.PROTOCOL_VERSION, 1, "Protocol version is packaged");
+  is(protocol.CONTRACT_SHA256.length, 64, "Contract hash is packaged");
+});
diff --git a/browser/components/preferences/tests/browser_bento_preferences.js b/browser/components/preferences/tests/browser_bento_preferences.js
new file mode 100644
index 0000000000000000000000000000000000000000..daa33fcb84c8c7d863fb63b2fcd2150bc2d99dc0
--- /dev/null
+++ b/browser/components/preferences/tests/browser_bento_preferences.js
@@ -0,0 +1,185 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+add_task(async function test_bento_root_and_controls() {
+  await openPreferencesViaOpenPreferencesAPI("bento", { leaveOpen: true });
+  let doc = gBrowser.contentDocument;
+  await TestUtils.waitForCondition(
+    () => doc.getElementById("setting-control-bento-uiColorMode"),
+    "Bento pane controls rendered"
+  );
+  ok(doc.getElementById("category-bento"), "Bento category exists");
+  let bentoPane = doc.querySelector('setting-pane[data-category="paneBento"]');
+  await bentoPane.pageHeaderEl.updateComplete;
+  is(
+    bentoPane.pageHeaderEl.heading,
+    "Bento",
+    "Bento pane uses Firefox's localized native page heading"
+  );
+  for (let id of [
+    "bento-uiColorMode",
+    "bento-tabSleepEnabled",
+    "bento-defaultWorkspaceName",
+    "bento-defaultPanelWidthPx",
+    "bento-privacy-protectionLevel",
+    "bento-autoBackupEnabled",
+    "bento-shortcuts-open",
+    "bento-reset",
+  ]) {
+    ok(doc.getElementById(`setting-control-${id}`), `${id} is rendered`);
+  }
+  let appearanceGroup = doc.querySelector(
+    'setting-group[groupid="bentoAppearance"]'
+  );
+  is(
+    appearanceGroup.querySelectorAll("setting-control").length,
+    1,
+    "Fluent group label preserves the Appearance controls"
+  );
+  is(
+    appearanceGroup.querySelector("moz-fieldset").label,
+    "Appearance",
+    "The group heading localizes through the fieldset label attribute"
+  );
+  let roundness = doc.querySelector("#bento-panelCornerRadiusPx");
+  let sizeList = doc.querySelector("#bento-customPanelSizes");
+  await TestUtils.waitForCondition(
+    () =>
+      roundness.querySelector("moz-slider")?.label === "Panel roundness" &&
+      sizeList.querySelector('label[is="moz-label"]')?.textContent ===
+        "Custom panel sizes" &&
+      sizeList.querySelector("moz-button")?.label === "Remove" &&
+      sizeList.querySelector("moz-input-number")?.ariaLabel === "Panel size",
+    "Panels controllers compose localized native Firefox controls"
+  );
+  is(
+    roundness.querySelector("moz-input-number").ariaLabel,
+    "Panel roundness",
+    "The panel roundness value field has the slider label"
+  );
+  is(
+    sizeList.querySelector("moz-box-group").type,
+    "reorderable-list",
+    "Panel sizes use Firefox's native reorderable list"
+  );
+  is(
+    sizeList.querySelector("moz-box-group").getAttribute("aria-labelledby"),
+    sizeList.querySelector('label[is="moz-label"]').id,
+    "The custom panel sizes label names the native reorderable list"
+  );
+  ok(
+    [...sizeList.querySelectorAll("moz-box-item")].every(
+      item => !item.hasAttribute("label") && !item.hasAttribute("data-l10n-id")
+    ),
+    "Reorderable panel size rows do not show position-based labels"
+  );
+  ok(
+    [...sizeList.querySelectorAll("moz-input-number")].every(
+      input => input.ariaLabel === "Panel size"
+    ),
+    "Panel size inputs keep an unnumbered accessible name"
+  );
+  Assert.deepEqual(
+    [...sizeList.querySelectorAll("moz-box-item:first-of-type moz-button")].map(
+      button => button.label
+    ),
+    ["Remove"],
+    "The native panel size action keeps only the visible remove button"
+  );
+  is(
+    doc.querySelectorAll(
+      "bento-range-control input, bento-size-list input, bento-size-list button"
+    ).length,
+    0,
+    "Bento panel controllers do not render custom light-DOM form controls"
+  );
+  BrowserTestUtils.removeTab(gBrowser.selectedTab);
+});
+
+add_task(async function test_bento_selects_open_firefox_panel_lists() {
+  await openPreferencesViaOpenPreferencesAPI("bento", { leaveOpen: true });
+  let doc = gBrowser.contentDocument;
+  await TestUtils.waitForCondition(
+    () => doc.getElementById("setting-control-bento-uiColorMode"),
+    "Bento pane controls rendered"
+  );
+
+  let selects = [
+    ...doc.querySelectorAll(
+      'setting-pane[data-category="paneBento"] moz-select'
+    ),
+  ];
+  Assert.greaterOrEqual(
+    selects.length,
+    6,
+    "Bento pane renders its expected select controls"
+  );
+  await Promise.all(selects.map(select => select.updateComplete));
+  for (let select of selects) {
+    ok(select.forcePanelList, `${select.id} forces Firefox panel-list mode`);
+    ok(select.usePanelList, `${select.id} uses Firefox panel-list mode`);
+    is(
+      select.inputEl.localName,
+      "button",
+      `${select.id} renders Firefox's native panel trigger`
+    );
+  }
+
+  let colorMode = doc.getElementById("bento-uiColorMode");
+  let shown = BrowserTestUtils.waitForEvent(colorMode.panelList, "shown");
+  EventUtils.synthesizeMouseAtCenter(colorMode.inputEl, {}, doc.defaultView);
+  await shown;
+  ok(colorMode.panelList.open, "Bento select opens its Firefox panel-list");
+
+  let hidden = BrowserTestUtils.waitForEvent(colorMode.panelList, "hidden");
+  colorMode.panelList.hide();
+  await hidden;
+  BrowserTestUtils.removeTab(gBrowser.selectedTab);
+});
+
+add_task(async function test_bento_shortcuts_use_native_components() {
+  await openPreferencesViaOpenPreferencesAPI("bentoShortcuts", {
+    leaveOpen: true,
+  });
+  let doc = gBrowser.contentDocument;
+  await TestUtils.waitForCondition(
+    () => doc.querySelector("bento-shortcut-list"),
+    "Bento shortcut controller rendered"
+  );
+  let controller = doc.querySelector("bento-shortcut-list");
+  await TestUtils.waitForCondition(
+    () => controller.querySelectorAll("moz-box-item").length > 1,
+    "Bento shortcut rows rendered"
+  );
+  ok(
+    controller.querySelector("moz-input-search"),
+    "Shortcuts use Firefox's native search field"
+  );
+  is(
+    controller.querySelector("moz-box-group").type,
+    "list",
+    "Shortcuts use Firefox's native list group"
+  );
+  is(
+    controller.querySelectorAll("input, button").length,
+    0,
+    "Shortcut controller does not render custom light-DOM form controls"
+  );
+  BrowserTestUtils.removeTab(gBrowser.selectedTab);
+});
+
+add_task(async function test_bento_visible_without_redesign() {
+  await SpecialPowers.pushPrefEnv({
+    set: [["browser.settings-redesign.enabled", false]],
+  });
+  await openPreferencesViaOpenPreferencesAPI("bento", { leaveOpen: true });
+  ok(
+    BrowserTestUtils.isVisible(
+      gBrowser.contentDocument.getElementById("category-bento")
+    ),
+    "Bento remains visible when redesign is disabled"
+  );
+  BrowserTestUtils.removeTab(gBrowser.selectedTab);
+});
