+    this.#slider = document.createElement("moz-slider");
+    this.#slider.min = min;
+    this.#slider.max = max;
+    this.#slider.ticks = max - min + 1;
+    this.#slider.value = min;
+    this.#slider.addEventListener("slider-changed", event => {
+      let value = Math.round(Number(event.detail));
+      this.#slider.value = value;
+      this.#valueInput.value = String(value);
+      this.dispatchEvent(new Event("change", { bubbles: true }));
+    });
+
+    this.#valueInput = document.createElement("moz-input-number");
+    this.#valueInput.value = String(min);
+    this.#valueInput.addEventListener("change", () => {
+      let value = Math.min(
+        max,
+        Math.max(min, Math.round(Number(this.#valueInput.value)))
+      );
+      this.#valueInput.value = String(value);
+      this.#slider.value = value;
+      this.dispatchEvent(new Event("change", { bubbles: true }));
+    });
