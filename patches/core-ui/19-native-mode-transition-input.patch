index 0000000000000000000000000000000000000000..78762e382d1ed217a6cfc1057c35c80466d34550
--- /dev/null
+++ b/dom/view-transitions/test/browser/browser_bento_native_theme_input.js
@@ -0,0 +1,223 @@
+/* Any copyright is dedicated to the Public Domain.
+   https://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+// Also serialized into a SpecialPowers.spawn sandbox for the ordinary-page
+// control. No await is allowed between the refresh and suppressed input probe.
+async function probeThemeInput(options, win = content) {
+  const doc = win.document;
+  const root = doc.documentElement;
+  const attrs = ["windowtype", "data-bento-mode-presentation", "style"];
+  const saved = attrs.map(name => [name, root.getAttribute(name)]);
+  const style = doc.createElementNS("http://www.w3.org/1999/xhtml", "style");
+  style.textContent = `
+    :root { view-transition-name: ${options.noOldRoot ? "none" : "root"} !important; }
+    :root * { view-transition-name: none !important; }
+    :root::view-transition, :root::view-transition-group(*),
+    :root::view-transition-image-pair(*), :root::view-transition-old(*),
+    :root::view-transition-new(*) { pointer-events: none !important; }
+    :root::view-transition-group(*) {
+      animation-duration: 100s !important;
+      animation-play-state: paused !important;
+    }
+  `;
+  const probe = doc.createElementNS("http://www.w3.org/1999/xhtml", "button");
+  probe.style.cssText =
+    "position: fixed; left: 120px; top: 120px; width: 100px; height: 40px; z-index: 2147483647; pointer-events: auto";
+  probe.textContent = "Owned input probe";
+  doc.body.append(style, probe);
+  const transitions = [];
+  function input() {
+    let result = null;
+    const observe = event => {
+      result = {
+        owned: event.target === probe,
+        root: event.target === root,
+        trusted: event.isTrusted,
+      };
+      event.preventDefault();
+      event.stopPropagation();
+    };
+    doc.addEventListener("mousedown", observe, { capture: true, once: true });
+    try {
+      const rect = probe.getBoundingClientRect();
+      const flags = {
+        toWindow: true,
+        isAsyncEnabled: false,
+        isDOMEventSynthesized: true,
+        isWidgetEventSynthesized: false,
+      };
+      win.synthesizeMouseEvent(
+        "mousedown",
+        rect.x + 20,
+        rect.y + 20,
+        {},
+        flags
+      );
+      win.synthesizeMouseEvent("mouseup", rect.x + 20, rect.y + 20, {}, flags);
+    } finally {
+      doc.removeEventListener("mousedown", observe, true);
+    }
+    return result;
+  }
+  function start(callback = false) {
+    const transition = callback
+      ? doc.startViewTransition(() => {})
+      : doc.startViewTransition();
+    const ready = transition.ready.then(
+      () => "ready",
+      error => error.name
+    );
+    transitions.push(transition);
+    return { transition, ready };
+  }
+  try {
+    if (options.marker === undefined)
+      root.removeAttribute("data-bento-mode-presentation");
+    else root.setAttribute("data-bento-mode-presentation", options.marker);
+    if (options.windowtype !== undefined)
+      root.setAttribute("windowtype", options.windowtype);
+    if (options.additionalOld)
+      probe.style.setProperty(
+        "view-transition-name",
+        "old_control",
+        "important"
+      );
+    const before = input();
+    const { transition, ready } = start(options.callback);
+    win.windowUtils.advanceTimeAndRefresh(0);
+    if (options.removeMarker)
+      root.removeAttribute("data-bento-mode-presentation");
+    const captured = input();
+    const result = { before, captured };
+    if (options.additionalNew)
+      probe.style.setProperty(
+        "view-transition-name",
+        "new_control",
+        "important"
+      );
+    if (options.noNewRoot)
+      root.style.setProperty("view-transition-name", "none", "important");
+    if (options.renameNewRoot)
+      root.style.setProperty("view-transition-name", "new_root", "important");
+    if (options.replace || options.skipThenReplace) {
+      if (options.skipThenReplace) {
+        transition.skipTransition();
+        result.afterSkip = input();
+      }
+      root.removeAttribute("data-bento-mode-presentation");
+      const replacement = start();
+      win.windowUtils.advanceTimeAndRefresh(0);
+      result.replacement = input();
+      replacement.transition.skipTransition();
+    }
+    result.ready = await ready;
+    result.afterReady = input();
+    return result;
+  } finally {
+    for (const transition of transitions) transition.skipTransition();
+    win.windowUtils.restoreNormalRefresh();
+    for (const [name, value] of saved) {
+      if (value === null) root.removeAttribute(name);
+      else root.setAttribute(name, value);
+    }
+    probe.remove();
+    style.remove();
+    await Promise.allSettled(
+      transitions.map(transition => transition.finished)
+    );
+  }
+}
+
+function checkInput(state, owned, description) {
+  ok(state, `${description}: an event was dispatched`);
+  ok(state.trusted, `${description}: trusted PresShell dispatch`);
+  is(state.owned, owned, `${description}: owned target`);
+  is(state.root, !owned, `${description}: document-root suppression`);
+}
+
+add_task(async function test_native_theme_capture_input() {
+  const win = await BrowserTestUtils.openNewBrowserWindow();
+  try {
+    await SimpleTest.promiseFocus(win);
+    for (const [description, options, owned] of [
+      ["missing marker control", {}, false],
+      ["wrong marker", { marker: "other" }, false],
+      ["wrong own identity", { marker: "theme", windowtype: "other" }, false],
+      [
+        "synchronous update callback",
+        { marker: "theme", callback: true },
+        false,
+      ],
+      [
+        "additional old capture",
+        { marker: "theme", additionalOld: true },
+        false,
+      ],
+      ["missing old root", { marker: "theme", noOldRoot: true }, false],
+      ["eligible root-only theme", { marker: "theme" }, true],
+      [
+        "marker removal remains latched",
+        { marker: "theme", removeMarker: true },
+        true,
+      ],
+    ]) {
+      const state = await probeThemeInput(options, win);
+      checkInput(state.before, true, `${description} before capture`);
+      checkInput(state.captured, owned, description);
+      is(state.ready, "ready", `${description}: retains ordinary lifecycle`);
+      // Named controls retain upstream event-list behavior during animation.
+      if (!options.additionalOld)
+        checkInput(state.afterReady, true, `${description} after activation`);
+    }
+    for (const options of [
+      { additionalNew: true },
+      { noNewRoot: true },
+      { renameNewRoot: true },
+    ]) {
+      const state = await probeThemeInput({ marker: "theme", ...options }, win);
+      checkInput(state.captured, true, "old capture opted in");
+      is(
+        state.ready,
+        "InvalidStateError",
+        "new membership violation skips before animation"
+      );
+      checkInput(state.afterReady, true, "violation releases suppression");
+    }
+    for (const options of [{ replace: true }, { skipThenReplace: true }]) {
+      const state = await probeThemeInput({ marker: "theme", ...options }, win);
+      checkInput(state.captured, true, "original theme opted in");
+      if (state.afterSkip)
+        checkInput(state.afterSkip, true, "skip releases suppression");
+      checkInput(
+        state.replacement,
+        false,
+        "unmarked replacement does not inherit latch"
+      );
+      is(state.ready, "AbortError", "replacement/skip aborts the original");
+    }
+    for (const [url, options] of [
+      [
+        "data:text/html,<body>ordinary page</body>",
+        { marker: "theme", windowtype: "navigator:browser" },
+      ],
+      ["about:config", { marker: "theme" }],
+    ]) {
+      await BrowserTestUtils.withNewTab(
+        { gBrowser: win.gBrowser, url },
+        async browser => {
+          const state = await SpecialPowers.spawn(
+            browser,
+            [options],
+            probeThemeInput
+          );
+          checkInput(state.before, true, `${url} before capture`);
+          checkInput(state.captured, false, `${url} cannot opt in`);
+        }
+      );
+    }
+  } finally {
+    await BrowserTestUtils.closeWindow(win);
+  }
+});
