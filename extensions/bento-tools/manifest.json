{
  "manifest_version": 2,
  "name": "Bento Tools",
  "short_name": "bento-tools",
  "version": "0.0.0",
  "description": "Bento Browser background tools — tab/keyboard/persistence logic.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bento-tools@bento.app",
      "strict_min_version": "150.0"
    }
  },
  "background": {
    "scripts": ["dist/background.js"],
    "persistent": false
  },
  "externally_connectable": {
    "ids": ["bento-shell@bento.app"]
  }
}
