{
  "name": "@bento/tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bento Browser tools — privileged background extension. Tab management, keyboard registry, workspace persistence.",
  "scripts": {
    "build": "esbuild src/background.ts --bundle --outfile=dist/background.js --format=iife --target=firefox128 --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
