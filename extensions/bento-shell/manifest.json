{
  "manifest_version": 2,
  "name": "Bento Shell",
  "short_name": "bento-shell",
  "version": "0.0.0",
  "description": "Bento Browser UI shell — privileged built-in extension.",
  "hidden": true,
  "browser_specific_settings": {
    "gecko": {
      "id": "bento-shell@bento.app",
      "strict_min_version": "150.0"
    }
  },
  "background": {
    "scripts": ["dist/assets/background.js"],
    "persistent": true
  },
  "permissions": ["storage"],
  "web_accessible_resources": [
    "dist/address-bar.html",
    "dist/confirm.html",
    "dist/edit-workspace.html",
    "dist/index.html",
    "dist/menu.html",
    "dist/merge-palette.html",
    "dist/palette.html",
    "dist/panel-newtab.html",
    "dist/panel-navigator-tooltip.html",
    "dist/panel-trailer.html",
    "dist/settings.html",
    "dist/welcome.html",
    "dist/workspace-palette.html",
    "dist/workspace-switcher.html",
    "dist/assets/*"
  ],
  "commands": {
    "dev-reload": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Dev: reload bento-shell extension"
    }
  }
}
