{
  "name": "@bento/shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bento Browser UI shell — privileged built-in extension. Vertical tabs, workspaces, panel layouts, command palette.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build && pnpm run build:background",
    "build:background": "node ../../scripts/build-extension-background.mjs src/background.ts dist/assets/background.js",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "ladle:serve": "ladle serve",
    "ladle:build": "ladle build"
  },
  "dependencies": {
    "@tale-ui/css": "2.0.0",
    "@tale-ui/react": "2.0.0",
    "@tale-ui/react-styles": "2.0.0",
    "@tale-ui/themes": "2.0.0",
    "@tale-ui/utils": "2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-aria-components": "^1.19.0",
    "zustand": "^5.0.0",
    "@tanstack/react-virtual": "^3.10.0",
    "lucide-react": "^0.460.0",
    "emojibase-data": "17.0.0"
  },
  "devDependencies": {
    "@ladle/react": "5.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vite": "6.4.3",
    "vitest": "^4.1.7"
  }
}
