{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.gluon.dev)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:gluon.org)",
      "WebFetch(domain:docs.zen-browser.app)",
      "Bash(jq *)",
      "mcp__tale-ui__list_components"
    ],
    "additionalDirectories": [
      "/Users/admin/Projects/surfer/src/utils",
      "/Users/admin/Projects/surfer/src/commands/patches",
      "/Users/admin/Projects/surfer",
      "/Users/admin/Projects/bento-browser/.claude"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/enforce-tale-ui-mcp.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
